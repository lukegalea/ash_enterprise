# Copy to .env and fill in. devenv loads .env automatically (dotenv.enable).
# .env is gitignored; this file is the committed template.

# --- AI provider (ash_ai uses ReqLLM) ---------------------------------------
# Uncomment ONE and give it a value. ReqLLM reads these straight from the
# environment -- no config entry is involved.
#
# Leave the rest commented rather than assigning them empty. A variable that is
# set and blank is worse than an absent one: ReqLLM finds it, reports the
# provider as configured, and then fails the request with "was found but is
# empty" -- which reads like a broken key rather than a missing one. (devenv
# unsets blanks in enterShell and the application treats them as absent, so this
# is a template that agrees with them rather than the only thing standing
# between you and a confusing error.)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Which model interprets agent requests, as "provider:model-id". Classification
# over one short sentence, so a small fast model is the right choice.
#
# Usually leave this alone. `AshEnterprise.AI.model/0` defaults to
# anthropic:claude-haiku-4-5-20251001, and devenv's enterShell points it at
# Openrouter automatically when that is the only key you have -- so the helper
# console works without anybody exporting anything. Set it to override both.
# AI_INTERPRETER_MODEL=openrouter:anthropic/claude-haiku-4.5

# --- Phoenix ----------------------------------------------------------------
# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# --- Signing salts (production and any non-dev environment) -----------------
# Dev and test boot with built-in salts and need nothing here. Every other
# environment must set both: at least 32 characters, different from each other,
# and not the built-in dev/test values (a release refuses to boot otherwise).
# Generate each with: mix phx.gen.secret 32
# SESSION_SIGNING_SALT=
# LIVE_VIEW_SIGNING_SALT=

# --- Sign-in through an OpenID Connect identity provider (ADR 0071) ---------
# Leave all four unset for password sign-in only. OIDC_BASE_URL must be set
# when the application is COMPILED: it decides whether the provider's sign-in
# button exists at all, so changing it needs a recompile. The other three are
# read at runtime. Register this application at the provider as a confidential
# client with the callback below, and give each person here the same email
# they have there, confirmed: a first sign-in reaches only that account, and
# nothing is ever created by one.
# OIDC_BASE_URL=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:4000/auth/user/oidc/callback

# --- Encryption at rest (ash_cloak / Cloak.Vault) ---------------------------
# Generate with: 32 |> :crypto.strong_rand_bytes() |> Base.encode64()
# CLOAK_KEY=

# --- OpenTelemetry ----------------------------------------------------------
# Unset means traces are logged, not exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ash_enterprise

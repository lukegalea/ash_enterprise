# Copy to .env and fill in. devenv loads .env automatically (dotenv.enable).
# .env is gitignored; this file is the committed template.

# --- AI provider (ash_ai uses ReqLLM) ---------------------------------------
# Set the key for whichever provider AI_INTERPRETER_MODEL names. ReqLLM reads
# these straight from the environment -- no config entry is involved.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Which model interprets agent requests, as "provider:model-id". Defaults to
# anthropic:claude-haiku-4-5-20251001. Classification over one short sentence,
# so a small fast model is the right choice.
# AI_INTERPRETER_MODEL=openrouter:anthropic/claude-haiku-4.5

# --- Phoenix ----------------------------------------------------------------
# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# --- Encryption at rest (ash_cloak / Cloak.Vault) ---------------------------
# Generate with: 32 |> :crypto.strong_rand_bytes() |> Base.encode64()
# CLOAK_KEY=

# --- OpenTelemetry ----------------------------------------------------------
# Unset means traces are logged, not exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ash_enterprise

# Copy to .env and fill in. devenv loads .env automatically (dotenv.enable).
# .env is gitignored; this file is the committed template.

# --- AI providers (ash_ai uses ReqLLM; set at least one) --------------------
# ReqLLM reads these via config :req_llm in config/runtime.exs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Phoenix ----------------------------------------------------------------
# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# --- Encryption at rest (ash_cloak / Cloak.Vault) ---------------------------
# Generate with: 32 |> :crypto.strong_rand_bytes() |> Base.encode64()
# CLOAK_KEY=

# --- OpenTelemetry ----------------------------------------------------------
# Unset means traces are logged, not exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ash_enterprise

{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tidewave": {
      "type": "remote",
      "url": "http://localhost:4000/tidewave/mcp",
      "enabled": true
    },
    "ash-agent": {
      "type": "remote",
      "url": "http://127.0.0.1:4197",
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "enabled": true
    }
  }
}

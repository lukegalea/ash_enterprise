#!/usr/bin/env bash
# claude-bg — observable headless claude runner.
# Usage: claude-bg <job-name> <prompt-file> [workdir]
# Streams JSON events to .agents/logs/<job-name>.stream.jsonl as they happen
# (file growth = liveness), writes final result to .agents/logs/<job-name>.result,
# and records pid/session for monitoring.
set -euo pipefail
JOB="$1"; PROMPT="$2"; DIR="${3:-$(pwd)}"
LOGDIR=".agents/logs"; mkdir -p "$LOGDIR"
STREAM="$LOGDIR/$JOB.stream.jsonl"
RESULT="$LOGDIR/$JOB.result"
META="$LOGDIR/$JOB.meta"
: > "$STREAM"
cd "$DIR"
nohup bash -c '
  claude -p --dangerously-skip-permissions \
    --output-format stream-json --verbose --include-partial-messages \
    "$(cat '"$PROMPT"')" > '"$STREAM"' 2> '"$LOGDIR/"$JOB".err"'
  echo "exit=$?" > '"$META".tmp'
  # extract final result text from stream
  python3 - > '"$RESULT"' <<PYEOF
import json
last = None
for line in open("'"$STREAM"'"):
    try: ev = json.loads(line)
    except Exception: continue
    if ev.get("type") == "result": last = ev.get("result")
print(last or "(no result event)")
PYEOF
  mv '"$META".tmp' '"$META"'
' > /dev/null 2>&1 &
echo "job=$JOB pid=$! stream=$STREAM"
echo "monitor: tail -f $STREAM   # growing file = alive; .meta exit= line = finished"

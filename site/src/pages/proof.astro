---
/**
 * The proof page: what is built, what tests it, and what is not there yet.
 *
 * Nothing here is typed by hand that a file in the repository already says:
 *
 *   - the scoreboard and checklist come from `docs/roadmap.json`;
 *   - the capability inventory from `docs/capabilities.json`;
 *   - the verification gates from `.github/workflows/ci.yml` (`lib/ci.ts`), so a
 *     job added or removed there fails this build until it is described here;
 *   - the control map from `docs/controls.json`. A criterion's state is read the
 *     way `ash_compliance`'s freshness evaluator reads it (see `criterionState`).
 *
 * `#generated-evidence` and `#control-map` are linked from other pages.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Scoreboard from '../components/Scoreboard.astro';
import SectionScoreboard from '../components/SectionScoreboard.astro';
import QuestionTable from '../components/QuestionTable.astro';
import StatusChip from '../components/StatusChip.astro';
import StatusIcon from '../components/StatusIcon.astro';
import Exhibit from '../components/Exhibit.astro';
import { statusLabel, type DeliveryStatus } from '../components/status';
import { inlineMarkdown } from '../components/inline';
import {
  frameworks,
  controlsInFramework,
  controlStatus,
  questionsFor,
  withBase,
  repoHref,
} from '../lib/roadmap';
import { facts, snippet, packageByName, numberWord, overrides } from '../lib/facts';
import { describe, jobTitle, ciStep, ciPath, ciPushBranches, ciOnPullRequests, type CiStep } from '../lib/ci';
import capabilitiesJson from '../../../docs/capabilities.json';
import controlsJson from '../../../docs/controls.json';

// ---------------------------------------------------------------------------
// Capabilities
// ---------------------------------------------------------------------------

type CapabilityStatus = 'existing' | 'partial' | 'missing' | 'refused';
interface CapabilityTest {
  file: string;
  test: string;
  dep?: string;
}
interface Capability {
  id: string;
  area: string;
  capability: string;
  status: CapabilityStatus;
  summary: string;
  gap?: string;
  tests?: CapabilityTest[];
}
interface CapabilitiesJson {
  reviewed: string;
  areas: { id: string; title: string }[];
  capabilities: Capability[];
}
const capabilitiesData = capabilitiesJson as unknown as CapabilitiesJson;

const capabilityWord: Record<CapabilityStatus, string> = {
  existing: 'Existing',
  partial: 'Partial',
  missing: 'Missing',
  refused: 'Refused',
};
/** The glyph each capability status borrows; `refused` has none. The word is always printed. */
const capabilityGlyph: Record<CapabilityStatus, DeliveryStatus | null> = {
  existing: 'shipped',
  partial: 'partial',
  missing: 'open',
  refused: null,
};

/** A test reference's URL: this repository, or a first-party package at the commit mix.lock pins. */
function testHref(t: CapabilityTest): string | null {
  if (!t.dep) return repoHref(t.file);
  const pkg = packageByName(t.dep);
  return pkg?.ref ? `${pkg.repo}/blob/${pkg.ref}/${t.file}` : null;
}

const capabilityAreas = capabilitiesData.areas.map((area) => ({
  area,
  rows: capabilitiesData.capabilities.filter((c) => c.area === area.id),
}));

// ---------------------------------------------------------------------------
// Verification gates
// ---------------------------------------------------------------------------

const gates = describe<string>({
  test: 'Everything except the suite: compile with warnings as errors, lint, check that generated code and catalogs are committed, scan for security problems and check for retired Hex packages.',
  'test-shards': 'The main suite, split by file across runners, each shard on a database of its own.',
  tests: 'One result for the whole suite. It fails when any shard failed or was cancelled.',
  durability:
    'Races between connections, jobs killed between two commits and leases taken over: what the SQL sandbox in the suite cannot show.',
  'backup-restore-drill':
    'Backs up a seeded database, restores it into a fresh one, and checks every table’s row count and every audit chain on the copy.',
  e2e: 'Every Playwright spec in assets/e2e, in Chromium, against a seeded development server.',
  telemetry: 'The telemetry package’s own suite, in its own mix project.',
  'browser-tests': 'The test-only browser package’s suite, driving Chromium against a small fixture application.',
  battery:
    'Flows that span two or more first-party packages, in battery/’s own mix project and database, after checking its pins match mix.lock.',
  dialyzer: 'Type analysis. It runs and reports, and does not fail the run (ADR 0007).',
  site: 'Builds this site (docs sync, link check, Astro) and scans what it would publish for private terms.',
  'cold-clone': 'Fetches every dependency with no credentials, so every git dependency has to be public.',
});

/** Setup steps (caches, installs, artifact uploads) are left out of the lists. */
const isSetup = (s: CiStep): boolean =>
  (s.name !== null && /^(Restore|Install|Locate|Upload)\b/.test(s.name)) ||
  (s.name === null && /^(mix deps\.(get|compile)|npm ci|mkdir)\b/.test(s.run ?? ''));

const blockingCount = gates.filter((g) => g.job.blocking).length;
/** The branches CI runs on, less `master`, which ci.yml lists but this repository does not have. */
const pushBranches = ciPushBranches.filter((b) => b !== 'master');
const advisory = gates.filter((g) => !g.job.blocking);

// ---------------------------------------------------------------------------
// The control file's criteria
// ---------------------------------------------------------------------------

interface Criterion {
  id: string;
  class: string;
  applicability: string;
  frequency: string;
  owner_role?: string;
  evidence_producer?: string;
  operating_process?: string;
  vendor_ref?: string;
  test_ref?: string;
}
const criteria = (controlsJson as unknown as { criteria: Criterion[] }).criteria;

/**
 * How `AshCompliance.Ownership.Freshness` (ash_compliance, at the commit mix.lock
 * pins) reads a row when no evidence artifact exists, which is the case for any
 * static build: a PLATFORM-ENFORCED row with an owner, a test and no evidence
 * source is `owned`; a row that declares a source needs a dated artifact inside
 * its window to be `evidenced`, so without one it is `unknown`; a row with no
 * source is `unknown`.
 */
type CriterionState = 'owned' | 'unknown';
function criterionState(c: Criterion): { state: CriterionState; why: string } {
  const sources = [c.evidence_producer, c.operating_process, c.class === 'VENDOR' ? c.vendor_ref : undefined].filter(
    Boolean,
  );
  if (c.applicability !== 'applicable' || !c.owner_role) return { state: 'unknown', why: 'no owner' };
  if (sources.length === 0 && c.class === 'PLATFORM-ENFORCED' && c.test_ref)
    return { state: 'owned', why: 'enforced, with a test; nothing to age' };
  if (sources.length === 0) return { state: 'unknown', why: 'no evidence source' };
  return { state: 'unknown', why: 'needs a dated artifact' };
}

const criteriaRows = criteria.map((c) => ({ c, ...criterionState(c) }));
const ownedCount = criteriaRows.filter((r) => r.state === 'owned').length;
const withSource = criteriaRows.filter((r) => r.why === 'needs a dated artifact').length;
const noSource = criteriaRows.filter((r) => r.why === 'no evidence source').length;

const classOrder = ['PLATFORM-ENFORCED', 'PLATFORM-EVIDENCED', 'HOST-APP', 'INFRA', 'VENDOR', 'ORG'];
const classMeaning: Record<string, string> = {
  'PLATFORM-ENFORCED': 'the platform enforces it, and a test proves it',
  'PLATFORM-EVIDENCED': 'the platform records the evidence',
  'HOST-APP': 'the application built on the platform',
  INFRA: 'the infrastructure it runs on',
  VENDOR: 'a vendor’s own report',
  ORG: 'the organization that adopts it: policy, people, review',
};
const byClass = classOrder
  .filter((k) => facts.controls.criteriaByClass[k])
  .map((k) => ({ k, n: facts.controls.criteriaByClass[k], meaning: classMeaning[k] ?? '' }));

const complianceDep = packageByName('ash_compliance');
const freshnessHref = complianceDep?.ref
  ? `${complianceDep.repo}/blob/${complianceDep.ref}/lib/ash_compliance/ownership/freshness.ex`
  : null;

const rows = frameworks.map((framework) => ({
  framework,
  controls: controlsInFramework(framework.id).map((control) => ({
    control,
    status: controlStatus(control),
    questions: questionsFor(control),
  })),
}));

// ---------------------------------------------------------------------------
// Security
// ---------------------------------------------------------------------------

const securityChecks = [
  { label: 'Security scan', step: ciStep('test', 'Security scan') },
  { label: 'Retired Hex packages', step: ciStep('test', 'Retired Hex packages') },
  { label: 'Iron laws judge', step: ciStep('test', 'Iron laws judge') },
  { label: 'Fetch dependencies with no credentials', step: ciStep('cold-clone', 'Fetch dependencies with no credentials') },
];
const assent = overrides.find((o) => o.name === 'assent');

const ex = snippet('control-evidence');
const cap = (s: string): string => s.replace(/^./, (c) => c.toUpperCase());
---

<Base
  title="Proof"
  description="What is built and what tests it, read from the repository's own ledgers and CI workflow: the checklist, the capability inventory, the verification gates and the control map."
  active="proof"
>
  <header class="ae-container-narrow pt-16 pb-4 sm:pt-20">
    <p class="ae-eyebrow">Proof</p>
    <h1 class="ae-h1 mt-4">What is built, what tests it, and what is not there yet</h1>
    <p class="ae-lead mt-6">
      Every number and status on this page is read at build time from a file in the repository: the checklist
      ledger, the capability inventory, the control file and the CI workflow. When one of them changes, this page
      changes with it.
    </p>
  </header>

  <Section
    id="scoreboard"
    step="01"
    eyebrow="Scoreboard"
    title="The counts"
    lead="Counted at build time from the checklist ledger, the capability inventory, the decision records, the control file and the test tree."
    wide
  >
    <Scoreboard variant="hero" />

    <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="ae-card p-5">
        <dt class="ae-eyebrow">Capabilities</dt>
        <dd class="mt-3">
          <p class="font-display text-3xl tabular-nums text-ae-ink">
            {facts.capabilities.byStatus.existing}<span class="text-ae-muted"> / {facts.capabilities.total}</span>
          </p>
          <p class="mt-2 text-sm text-ae-muted">
            exist and are tested; {facts.capabilities.byStatus.partial} partial, {facts.capabilities.byStatus.missing}
            missing, {facts.capabilities.byStatus.refused} refused on purpose.
          </p>
        </dd>
      </div>
      <div class="ae-card p-5">
        <dt class="ae-eyebrow">Decision records</dt>
        <dd class="mt-3">
          <p class="font-display text-3xl tabular-nums text-ae-ink">
            {facts.adrs.byStatus.accepted}<span class="text-ae-muted"> / {facts.adrs.total}</span>
          </p>
          <p class="mt-2 text-sm text-ae-muted">
            accepted; {facts.adrs.byStatus.proposed} proposed and {facts.adrs.byStatus.superseded} superseded.
          </p>
        </dd>
      </div>
      <div class="ae-card p-5">
        <dt class="ae-eyebrow">SOC 2 criteria</dt>
        <dd class="mt-3">
          <p class="font-display text-3xl tabular-nums text-ae-ink">
            {facts.controls.criteriaWithEvidenceProducer}<span class="text-ae-muted"> / {facts.controls.criteria}</span>
          </p>
          <p class="mt-2 text-sm text-ae-muted">
            name an evidence producer. None is evidenced on this page: that takes dated artifacts.
          </p>
        </dd>
      </div>
      <div class="ae-card p-5">
        <dt class="ae-eyebrow">Test files</dt>
        <dd class="mt-3">
          <p class="font-display text-3xl tabular-nums text-ae-ink">{facts.tests.files}</p>
          <p class="mt-2 text-sm text-ae-muted">
            in the main suite. The battery, telemetry and browser packages have suites of their own.
          </p>
        </dd>
      </div>
    </dl>
  </Section>

  <Section
    id="generated-evidence"
    step="02"
    eyebrow="The checklist"
    title="Every enterprise question, its answer and its proof"
    lead="One ratio across the whole checklist hides where the work is. The sections show which parts are nearly done and which have barely started."
    tone="muted"
    wide
  >
    <div class="ae-card p-6 sm:p-8">
      <SectionScoreboard />
    </div>

    <div class="mt-16">
      <QuestionTable />
    </div>

    <div class="mt-12 flex flex-wrap gap-3">
      <a class="ae-btn" href={withBase('/docs/questions/')}>The checklist, in prose</a>
      <a class="ae-btn" href={withBase('/roadmap/')}>What is planned, and why</a>
    </div>
  </Section>

  <Section
    id="capabilities"
    step="03"
    eyebrow="Capabilities"
    title="A fixed list of capabilities, graded"
    lead={`Workflow, agents and enterprise operation, graded against a list that does not grow to fit what was built. Last reviewed against the tree on ${capabilitiesData.reviewed}.`}
    wide
  >
    <p class="ae-body" slot="aside">
      Existing means a test named in the row would fail if it regressed. Partial means part works and is tested, and
      the row says what is missing. Missing names no tests. Refused is deliberately not built, with the reason.{' '}
      <code class="ae-code">test/ash_enterprise/capability_inventory_test.exs</code> fails when a row cites a test that
      does not exist, or an existing or partial row cites none.
    </p>

    <div class="space-y-14">
      {
        capabilityAreas.map(({ area, rows: caps }) => (
          <section aria-labelledby={`cap-${area.id}`}>
            <h3 id={`cap-${area.id}`} class="ae-h3 border-b border-ae-rule-strong pb-3">
              {area.title}
            </h3>
            <ul class="divide-y divide-ae-rule">
              {caps.map((cap) => (
                <li id={`cap-${cap.id}`} class="grid gap-3 py-5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-6">
                  <div>
                    <p class="font-medium text-ae-ink">{cap.capability}</p>
                    <p class="mt-1.5 flex items-center gap-1.5 text-xs font-medium text-ae-muted">
                      {capabilityGlyph[cap.status] && (
                        <StatusIcon status={capabilityGlyph[cap.status]!} size={12} />
                      )}
                      {capabilityWord[cap.status]}
                    </p>
                  </div>
                  <div class="min-w-0 text-sm leading-relaxed">
                    <p class="text-ae-ink" set:html={inlineMarkdown(cap.summary)} />
                    {cap.gap && (
                      <p class="mt-2 text-ae-muted">
                        <span class="font-medium text-ae-ink">
                          {cap.status === 'refused' ? 'Why not: ' : 'Gap: '}
                        </span>
                        <span set:html={inlineMarkdown(cap.gap)} />
                      </p>
                    )}
                    {cap.tests && cap.tests.length > 0 && (
                      <details class="mt-2">
                        <summary class="cursor-pointer text-xs text-ae-muted hover:text-ae-ink">
                          {cap.tests.length} {cap.tests.length === 1 ? 'test' : 'tests'}
                        </summary>
                        <ul class="mt-2 space-y-1.5 text-xs">
                          {cap.tests.map((t) => {
                            const href = testHref(t);
                            return (
                              <li class="text-ae-muted">
                                {href ? (
                                  <a class="ae-link font-mono" href={href}>
                                    {t.dep ? `${t.dep}: ` : ''}
                                    {t.file}
                                  </a>
                                ) : (
                                  <span class="font-mono">{t.file}</span>
                                )}
                                <span> — {t.test}</span>
                              </li>
                            );
                          })}
                        </ul>
                      </details>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="mt-12 flex flex-wrap gap-3">
      <a class="ae-btn" href={repoHref('docs/capabilities.json')}>docs/capabilities.json</a>
    </div>
  </Section>

  <Section
    id="verification-gates"
    step="04"
    eyebrow="Verification gates"
    title="What CI runs"
    lead={`${cap(numberWord(gates.length))} jobs run on every push to ${pushBranches.join(', ')}${ciOnPullRequests ? ' and on every pull request' : ''}. ${cap(numberWord(blockingCount))} of them fail the run when they fail.`}
    tone="muted"
    wide
  >
    <p class="ae-body" slot="aside">
      Read from <a class="ae-link font-mono" href={repoHref(ciPath)}>{ciPath}</a> when this site was built.
      {
        advisory.length > 0 && (
          <span>
            {' '}
            {advisory.length === 1 ? 'The one that does not gate is' : 'The ones that do not gate are'}{' '}
            {advisory.map((g) => jobTitle(g.job)).join(', ')}, which {advisory.length === 1 ? 'sets' : 'set'}{' '}
            <code class="ae-code">continue-on-error</code>.
          </span>
        )
      }{' '}
      A <code class="ae-code">ci/**</code> branch lets a change run the whole gate before it reaches main.
    </p>

    <ol class="space-y-3">
      {
        gates.map(({ job, about }) => {
          const steps = job.steps.filter((s) => !isSetup(s));
          return (
            <li id={`gate-${job.id}`} class="ae-card">
              <details>
                <summary class="flex cursor-pointer flex-wrap items-baseline justify-between gap-x-4 gap-y-1 p-5">
                  <span class="min-w-0">
                    <span class="font-medium text-ae-ink">{jobTitle(job)}</span>
                    {job.matrix && <span class="text-ae-muted"> · {job.matrix} runners</span>}
                    <span class="mt-1 block text-sm leading-relaxed text-ae-muted">{about}</span>
                  </span>
                  <span class="font-mono text-xs tracking-wide text-ae-muted uppercase">
                    {job.blocking ? 'Gates' : 'Advisory'}
                  </span>
                </summary>
                {steps.length > 0 && (
                  <ol class="space-y-2 border-t border-ae-rule px-5 py-4 text-sm">
                    {steps.map((s) => (
                      <li class="grid gap-1 sm:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] sm:gap-4">
                        <span class="text-ae-ink">{s.name ?? 'Run'}</span>
                        {s.run ? (
                          <code class="ae-code min-w-0 self-start overflow-x-auto whitespace-nowrap">{s.run}</code>
                        ) : (
                          <span />
                        )}
                      </li>
                    ))}
                  </ol>
                )}
              </details>
            </li>
          );
        })
      }
    </ol>
  </Section>

  <Section
    id="control-map"
    step="05"
    eyebrow="Control map"
    title="What an auditor asks, and where this stands"
    lead="An engineering document in an auditor's vocabulary. It is not an assertion of compliance and does not replace an audit."
    wide
  >
    <div slot="aside">
      <p>
        Much of a real control is not in a repository: the policy, the training, the review cadence, and an
        auditor's judgement that it all operated over a period. What follows covers the part that is code.
      </p>
      <p class="mt-3">
        A control is scored by its <em>weakest</em> question, not its average: one open question is one an auditor
        will ask about.
      </p>
    </div>

    {
      rows.map(({ framework, controls }) => (
        <div id={`framework-${framework.id}`} class="mt-14 scroll-mt-24 first:mt-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="ae-h3">{framework.name}</h3>
            <p class="font-mono text-xs text-ae-muted">{framework.revision}</p>
          </div>

          <ul class="mt-6 space-y-4">
            {controls.map(({ control, status, questions }) => (
              <li class="ae-card p-5">
                <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
                  <h4 class="text-base font-semibold text-balance">
                    <span class="font-mono text-ae-copper">{control.id}</span>{' '}
                    <span class="text-ae-ink">{control.name}</span>
                  </h4>
                  <StatusChip status={status} />
                </div>

                <p class="mt-3 text-sm leading-relaxed text-ae-muted italic">{control.asks}</p>

                <p class="mt-3 text-sm leading-relaxed text-ae-muted" set:html={inlineMarkdown(control.note)} />

                <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-ae-rule pt-4">
                  <span class="text-xs text-ae-muted">Bearing on it:</span>
                  {questions.map((question) => (
                    <span
                      class="inline-flex items-center gap-1.5 rounded-ae border border-ae-rule bg-ae-paper-2 px-2 py-1 text-xs"
                      title={question.question}
                    >
                      <StatusIcon status={question.status} size={12} />
                      <span class="sr-only">{statusLabel[question.status]}:</span>
                      <span class="font-mono text-ae-muted">{question.id}</span>
                      {question.proof ? (
                        <a class="ae-link" href={repoHref(question.proof)}>
                          proof<span class="sr-only"> for {question.id}</span>
                        </a>
                      ) : null}
                    </span>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div id="criteria" class="mt-20 scroll-mt-24">
      <h3 class="ae-h3">Who owns each of the {facts.controls.criteria} SOC 2 criteria</h3>
      <div class="ae-body mt-4 space-y-3">
        <p>
          <code class="ae-code">docs/controls.json</code> has a row for every Trust Services Criterion. A row names the
          class of owner, the accountable role, and the evidence producer, operating process and test where one exists.
          It never carries a status: <code class="ae-code">ash_compliance</code> derives one each time it is asked, and
          the only answers are <strong class="text-ae-ink">owned</strong>,{' '}
          <strong class="text-ae-ink">evidenced</strong> and <strong class="text-ae-ink">unknown</strong> (or not
          applicable, with a stated rationale). None of them means compliant.
        </p>
        <p>
          Evidenced needs a dated artifact from every source a row declares, inside the row's window. Artifacts are
          recorded by a running deployment, and a static page holds none, so the states below are what the evaluator
          returns with no evidence at all: {ownedCount} rows are owned (enforced by the platform, with a test and nothing
          to age), {withSource} declare a source and read unknown until it produces an artifact, and {noSource} declare
          no source yet.
          {
            freshnessHref && (
              <span>
                {' '}
                The rule is <a class="ae-link" href={freshnessHref}>AshCompliance.Ownership.Freshness</a>.
              </span>
            )
          }
        </p>
      </div>

      <dl class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          byClass.map(({ k, n, meaning }) => (
            <div class="border border-ae-rule bg-ae-paper-2 px-4 py-3">
              <dt class="font-mono text-xs text-ae-muted">{k}</dt>
              <dd class="mt-1 text-sm">
                <span class="font-semibold tabular-nums text-ae-ink">{n}</span>
                <span class="text-ae-muted"> — {meaning}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <Exhibit
        class="mt-10"
        label="Exhibit"
        title={ex.title}
        source={ex.file}
        lines={`${ex.startLine}-${ex.endLine}`}
        code={ex.code}
        lang={ex.lang}
        caption={ex.caption}
      />

      <div class="ae-overflow mt-10 border border-ae-rule" tabindex="0" role="region" aria-label="SOC 2 criteria and their owners">
        <table class="w-full min-w-[44rem] text-left text-sm">
          <caption class="sr-only">
            Each SOC 2 criterion with its owner class, role, frequency, declared sources and the state ash_compliance
            reads with no evidence recorded
          </caption>
          <thead class="bg-ae-paper-2 text-xs text-ae-muted">
            <tr>
              <th scope="col" class="px-3 py-2 font-medium">Criterion</th>
              <th scope="col" class="px-3 py-2 font-medium">Class</th>
              <th scope="col" class="px-3 py-2 font-medium">Owner</th>
              <th scope="col" class="px-3 py-2 font-medium">Window</th>
              <th scope="col" class="px-3 py-2 font-medium">Declares</th>
              <th scope="col" class="px-3 py-2 font-medium">Read with no evidence</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ae-rule">
            {
              criteriaRows.map(({ c, state, why }) => (
                <tr>
                  <th scope="row" class="px-3 py-2 font-mono font-normal text-ae-ink">{c.id}</th>
                  <td class="px-3 py-2 font-mono text-xs text-ae-muted">{c.class}</td>
                  <td class="px-3 py-2 text-ae-muted">{c.owner_role}</td>
                  <td class="px-3 py-2 text-ae-muted">{c.frequency}</td>
                  <td class="px-3 py-2 text-xs text-ae-muted">
                    {[c.evidence_producer && 'producer', c.operating_process && 'process', c.test_ref && 'test']
                      .filter(Boolean)
                      .join(', ') || '—'}
                  </td>
                  <td class="px-3 py-2">
                    <span class="flex flex-wrap items-center gap-2">
                      <StatusChip status={state} size="sm" />
                      <span class="text-xs text-ae-muted">{why}</span>
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        <a class="ae-btn" href={withBase('/docs/compliance/')}>The control map, in the docs</a>
        <a class="ae-btn" href={repoHref('docs/controls.json')}>docs/controls.json</a>
      </div>
    </div>
  </Section>

  <Section
    id="security"
    step="06"
    eyebrow="Security"
    title="What the code does about security, and what it leaves to the deployment"
    tone="muted"
  >
    <div class="ae-body space-y-4">
      <p>
        Authorization is a union of grants with no deny rule for row access, and the policy checks read a context
        computed once per request rather than querying. The argument is{' '}
        <a class="ae-link" href={withBase('/docs/manifesto/03-authorization-is-data/')}>thesis 3</a>; the identity
        rows of the checklist above say what is built.
      </p>
      <p>
        Cryptography is standard primitives for a few named jobs: a SHA-256 hash chain over the audit log; AES-256-GCM
        sealing under per-scope keys for crypto-shredding (ADR 0024); HMAC-SHA256 for keyed digests (sub-keys of an
        erasure scope's key, invocation argument digests, master-data assertion digests) and for checking signed
        provider webhooks; bcrypt password hashes; and the signed session tokens and cookies that ash_authentication
        and Phoenix provide. Everywhere else SHA-256 is a content fingerprint, not a secret.
      </p>
      <p>
        TLS termination, disk encryption and storage of the erasure master key are the deployment's. The application
        forces HTTPS in production and refuses to boot without the key. No written key-management rule exists here,
        and the control map counts that as a gap.
      </p>
    </div>

    <h3 class="ae-h3 mt-12">Security checks in the CI gate</h3>
    <ul class="mt-5 space-y-3">
      {
        securityChecks.map(({ label, step }) => (
          <li class="ae-card grid gap-1 p-4 sm:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] sm:gap-4">
            <span class="text-sm text-ae-ink">{label}</span>
            <code class="ae-code min-w-0 self-start overflow-x-auto whitespace-nowrap text-xs">{step.run}</code>
          </li>
        ))
      }
    </ul>

    {
      assent && (
        <p class="ae-body mt-8">
          One dependency is overridden for a security fix: <code class="ae-code">assent {assent.requirement}</code>.{' '}
          <span set:html={inlineMarkdown(assent.reason)} />{' '}
          <a class="ae-link" href={withBase('/packages/#overrides')}>
            Forks and overrides
          </a>
          .
        </p>
      )
    }
  </Section>
</Base>

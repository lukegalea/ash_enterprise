---
/**
 * The only 404 on the site — Starlight's own is disabled in `astro.config.mjs`
 * so it cannot collide with this route.
 */
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/roadmap';
---

<Base title="Page not found" description="That page does not exist on this site.">
  <section class="ae-container-narrow flex flex-col items-center py-28 text-center sm:py-40">
    <p class="ae-eyebrow">404</p>
    <h1 class="ae-h1 mt-4">That page is not here</h1>
    <p class="ae-lead mx-auto mt-5">
      The link may be stale, or the page may have moved. The manifesto, the decision records and the plans all live
      under <code class="ae-code">/docs</code>.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a class="ae-btn" href={withBase('/')}>Back to the overview</a>
      <a class="ae-btn" href={withBase('/docs/')}>Browse the docs</a>
      <a class="ae-btn" href={withBase('/roadmap/')}>Roadmap</a>
    </div>
  </section>
</Base>

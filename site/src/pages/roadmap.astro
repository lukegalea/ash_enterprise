---
/**
 * The roadmap page: the items still ahead, by priority.
 *
 * Rendered from `docs/roadmap.json`, keeping only items that are not shipped,
 * so an item that ships leaves this page on the next build (the proof page
 * keeps the checklist it closes). The prose around the items is
 * `docs/ROADMAP.md`'s: the one bar every external tool had to clear, the
 * sequencing, and the premises that did not survive checking.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import StatusChip from '../components/StatusChip.astro';
import StatusIcon from '../components/StatusIcon.astro';
import { statusLabel } from '../components/status';
import { inlineMarkdown } from '../components/inline';
import { items, counts, withBase, adrHref, repoHref, type Item } from '../lib/roadmap';
import { numberWord } from '../lib/facts';
import { ciStep } from '../lib/ci';

const cap = (s: string): string => s.replace(/^./, (c) => c.toUpperCase());

/** Forward items: everything not yet shipped. */
const forward: Item[] = items.filter((i) => i.status !== 'shipped');
const tally = counts(forward);
const shippedCount = items.length - forward.length;
const forwardStatuses = (['partial', 'planned', 'open'] as const).filter((s) => tally[s] > 0);

const groups = [...new Set(forward.map((i) => i.priority))]
  .sort((a, b) => a - b)
  .map((priority) => ({ priority, rows: forward.filter((i) => i.priority === priority) }));

/** docs/ROADMAP.md, "Sequencing, and why". */
const priorityIntro: Record<number, { label: string; text: string }> = {
  1: {
    label: 'A chain, not a set',
    text: 'Ingestion first, because lineage and cataloguing mean nothing without something producing traceable ingestion events. Lineage next, because the correlation id is already threaded through every action. The integration hub sits alongside rather than after: it answers a different question, data you pull against systems you talk to.',
  },
  2: {
    label: 'Consumes what priority 1 produces',
    text: 'A catalog needs something to catalogue, and BI needs something to report on. API versioning sits here because it is likely to be needed before it is wanted: once the JSON:API surface has an external consumer, changing it becomes expensive.',
  },
  3: {
    label: 'Deferrable',
    text: 'Feature flags matter when there are enough users to stage a rollout to.',
  },
  4: {
    label: 'Deferrable',
    text: 'Entity resolution matters when the same customer has arrived from three systems, which is a consequence of priority 1 rather than a precondition for it.',
  },
};

/** docs/ROADMAP.md, "Where the neat story did not survive checking". */
const corrections: { claim: string; correction: string }[] = [
  {
    claim: 'Meltano is Apache-2.0, and Airbyte’s connectors are MIT.',
    correction:
      'Meltano is MIT. Airbyte’s connectors moved from MIT to ELv2 in July 2025, so the fallback is source-available throughout.',
  },
  {
    claim: 'The ingestion tool will emit lineage events.',
    correction:
      'Neither Meltano nor Airbyte emits OpenLineage, which leaves a hole in the lineage graph exactly where external data enters. The hole is drawn as a hole: a diagram that leaves out edges it could not work out reads as “nothing feeds this”.',
  },
  {
    claim: 'OpenMetadata is one Postgres, which put it ahead of DataHub.',
    correction:
      'OpenMetadata requires Elasticsearch or OpenSearch. It is two stateful services, and that was the argument that put it ahead of DataHub.',
  },
  {
    claim: 'Marquez upgrades cheaply into the chosen catalog.',
    correction:
      'OpenMetadata’s OpenLineage ingest is a Kafka or Kinesis consumer, not an HTTP endpoint. The cheap upgrade from Marquez is DataHub, a base-URL change, so ADR 0012’s exit and ADR 0013’s destination point at different products. Both records say so.',
  },
];

// The closing section names this CI step; the build fails if it is renamed or removed.
const roadmapCheck = ciStep('test', 'Check the roadmap tables are rendered');
---

<Base
  title="Roadmap"
  description={`The ${forward.length} roadmap items not yet shipped, by priority: each one a recorded decision with the work it implies and whether it clears the platform's one bar for external tools.`}
  active="roadmap"
>
  <header class="ae-container-narrow pt-16 pb-4 sm:pt-20">
    <p class="ae-eyebrow">Roadmap</p>
    <h1 class="ae-h1 mt-4">What is still ahead, in what order, and why</h1>
    <p class="ae-lead mt-6">
      {cap(numberWord(forward.length))} items are not shipped. Each one names the choice made, what the work actually
      is, and whether the tool clears the one bar every external tool had to clear. Each is a decision you can read
      and disagree with, not a promise.
    </p>
    <dl class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      {
        forwardStatuses.map((status) => (
          <div class="flex items-center gap-1.5">
            <dt class="flex items-center gap-1.5 text-ae-muted">
              <StatusIcon status={status} size={12} />
              {statusLabel[status]}
            </dt>
            <dd class="font-semibold tabular-nums">{tally[status]}</dd>
          </div>
        ))
      }
    </dl>
    <p class="ae-body mt-4">
      {cap(numberWord(shippedCount))} items have shipped and are left off this page; the prose roadmap lists every
      item, and the <a class="ae-link" href={withBase('/proof/#generated-evidence')}>proof page</a> shows the checklist
      they answer.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="ae-btn" href={withBase('/docs/roadmap/')}>The roadmap, in prose</a>
      <a class="ae-btn" href={withBase('/docs/adr/')}>All decision records</a>
    </div>
  </header>

  <Section
    id="the-bar"
    step="01"
    eyebrow="The bar"
    title="The one rule every item was selected against"
    lead="It disqualified several tools that would otherwise have won on features."
    tone="muted"
  >
    <blockquote class="ae-card border-ae-workshop/40 p-6 font-display text-xl leading-relaxed text-pretty text-ae-ink sm:p-8">
      An external tool earns a place only if it can be handed a thin, generated declaration and delegate authorization
      back to <code class="ae-code">AshEnterprise.Security.ActorContext</code>.
    </blockquote>
    <p class="ae-body mt-6">
      A tool that brings its own roles, its own tenancy model or its own audit trail is a second copy of the security
      model to keep in step, and a synchronization job drifts, usually in the permissive direction. Three strong
      products lose on this specifically: Metabase (ADR 0014), Camunda and Flowable (ADR 0015), and Unleash (ADR 0016).
    </p>
  </Section>

  {
    groups.map(({ priority, rows }, gi) => {
      const intro = priorityIntro[priority];
      return (
        <Section
          id={`priority-${priority}`}
          step={String(gi + 2).padStart(2, '0')}
          eyebrow={`Priority ${priority} · ${rows.length} ${rows.length === 1 ? 'item' : 'items'}`}
          title={intro?.label ?? `Priority ${priority}`}
          lead={intro?.text}
          tone={gi % 2 === 1 ? 'muted' : 'default'}
        >
          <div class="space-y-6">
            {rows.map((item) => {
              const adr = adrHref(item.adr);
              return (
                <article id={item.id} class="ae-card scroll-mt-24 p-6 sm:p-8">
                  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
                    <div class="min-w-0">
                      <h3 class="ae-h3">{item.title}</h3>
                      <p class="mt-1.5 font-mono text-sm text-ae-workshop">{item.choice}</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-3">
                      <StatusChip status={item.status} />
                      {adr ? (
                        <a class="ae-link font-mono text-xs" href={adr}>
                          ADR {item.adr}
                        </a>
                      ) : item.adr ? (
                        <span class="font-mono text-xs text-ae-muted">ADR {item.adr}</span>
                      ) : null}
                    </div>
                  </div>

                  <dl class="mt-7 grid gap-7 sm:grid-cols-2">
                    <div>
                      <dt class="ae-eyebrow">What the work is</dt>
                      <dd class="mt-2.5 text-sm leading-relaxed text-pretty" set:html={inlineMarkdown(item.effort)} />
                    </div>
                    {item.bar && (
                      <div>
                        <dt class="ae-eyebrow">Does it consume ActorContext?</dt>
                        <dd
                          class="mt-2.5 border-l-2 border-ae-workshop/40 pl-4 text-sm leading-relaxed text-pretty text-ae-muted"
                          set:html={inlineMarkdown(item.bar)}
                        />
                      </div>
                    )}
                  </dl>
                </article>
              );
            })}
          </div>
        </Section>
      );
    })
  }

  <Section
    id="corrections"
    step={String(groups.length + 2).padStart(2, '0')}
    eyebrow="Corrections"
    title="Where the neat story did not survive checking"
    lead="Four premises this roadmap was drafted on turned out to be wrong. The corrections are more useful than the tidier version."
    tone={groups.length % 2 === 1 ? 'muted' : 'default'}
  >
    <ol class="space-y-5">
      {
        corrections.map(({ claim, correction }, i) => (
          <li class="ae-card grid gap-4 p-6 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-6">
            <span
              class="grid h-8 w-8 shrink-0 place-items-center border border-ae-rule font-mono text-xs text-ae-muted"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div>
              <p class="text-sm text-ae-muted">
                <span class="sr-only">Drafted on: </span>
                <s class="decoration-ae-rule-strong">{claim}</s>
              </p>
              <p class="mt-2 leading-relaxed text-pretty">{correction}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section
    id="how-it-stays-honest"
    step={String(groups.length + 3).padStart(2, '0')}
    eyebrow="Source"
    title="How this page stays honest"
  >
    <div class="ae-body space-y-4">
      <p>
        Every status here is read at build time from{' '}
        <a class="ae-link font-mono" href={repoHref('docs/roadmap.json')}>docs/roadmap.json</a>, the file the README, the
        checklist and the prose roadmap render from. CI runs{' '}
        <code class="ae-code">{roadmapCheck.run}</code>, which fails when a rendered table disagrees with it. A status
        can be wrong in one place only by being wrong in all of them, which is easier to notice.
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="ae-btn" href={withBase('/docs/roadmap/')}>The full roadmap</a>
      <a class="ae-btn" href={withBase('/docs/manifesto/07-what-we-do-not-have/')}>What we do not have</a>
    </div>
  </Section>
</Base>

---
/**
 * The homepage — a short, calm argument in the Enterprise Atelier direction.
 *
 * The fold sells the possibility; Fig. 1 shows the leverage; the specimen
 * proves one declaration end-to-end; the sections after it stage the team
 * model, the capabilities, the seams, and the doctrine. Everything deep lives
 * one click away — the proof pages, the manifesto, the source.
 *
 * Every internal href goes through `withBase`; every colour comes from the
 * `--ae-*` tokens so the `data-theme` dark swap just works.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import StackElevation from '../components/home/StackElevation.astro';
import SpecimenPlate from '../components/home/SpecimenPlate.astro';
import { withBase } from '../lib/roadmap';

const GITHUB = 'https://github.com/lukegalea/ash_enterprise';

/* --- Shared rhythm ------------------------------------------------------- */

const container = 'mx-auto w-full max-w-[1280px] px-6 sm:px-8 lg:px-14';
const eyebrow = 'font-mono text-[11px] uppercase tracking-[0.18em] text-ae-copper';
const h2 =
  'mt-4 max-w-[860px] font-display text-[36px] leading-[1.08] tracking-[-0.015em] font-normal text-ae-ink lg:text-[48px]';
const lead = 'mt-6 max-w-[560px] text-[19px] leading-[1.6] text-ae-ink text-pretty';
const underlineLink =
  'self-start border-b border-ae-workshop font-sans text-[15px] font-medium text-ae-workshop transition-colors duration-150 hover:border-ae-vermilion hover:text-ae-vermilion';

/* --- Section 04 — the team model ----------------------------------------- */

const teamColumns: { label: string; title: string; body: string }[] = [
  {
    label: '01 — humans',
    title: 'Your team owns judgment',
    body: 'You decide what the business means: where one domain ends and the next begins, which exceptions are real, which records may be merged, which decisions cannot be undone. The framework keeps those decisions explicit and central — never scattered across controllers, callbacks, and tribal memory.',
  },
  {
    label: '02 — agents',
    title: 'Agents move quickly',
    body: 'An agent works here the way a strong new hire would: it reads the generated rules, inspects the running system, proposes changes, and operates existing actions through existing policies. It can generate a resource that already carries audit, tenancy, and ownership — because there is no other kind of resource to generate.',
  },
  {
    label: '03 — the framework',
    title: 'The framework enforces coherence',
    body: 'Every request — human or agent — resolves through the same actions, the same policy union, the same audit trail, under the actor who initiated it. There is no privileged path to remember to secure, because there is no privileged path at all.',
  },
];

/* --- Section 05 — capabilities ------------------------------------------- */

const capabilities: { name: string; outcome: string; linkLabel: string; href: string }[] = [
  {
    name: 'Identity and authorization',
    outcome: 'Ownership, hierarchy, sharing, and additive grants come from one actor model.',
    linkLabel: 'See the capability →',
    href: withBase('/product/#identity'),
  },
  {
    name: 'Audit and evidence',
    outcome:
      'Every action is attributable; the chain can reveal tampering and export an auditor’s window.',
    linkLabel: 'Open the evidence →',
    href: withBase('/proof/'),
  },
  {
    name: 'Workflow and decisions',
    outcome:
      'BPMN and DMN become versioned application data, with human approvals and FEEL conditions.',
    linkLabel: 'See the capability →',
    href: withBase('/product/#workflow'),
  },
  {
    name: 'Legacy adoption',
    outcome:
      'Map rather than rewrite; move through reversible phases while the old system keeps running.',
    linkLabel: 'See the capability →',
    href: withBase('/product/#legacy'),
  },
  {
    name: 'Derived surfaces',
    outcome: 'Admin, JSON:API, GraphQL, and agent tools read the same domain and policies.',
    linkLabel: 'See the capability →',
    href: withBase('/product/#surfaces'),
  },
  {
    name: 'Tenant-safe agents',
    outcome: 'Models receive existing actions, not a privileged mutation path.',
    linkLabel: 'See the capability →',
    href: withBase('/product/#agents'),
  },
];

/* --- Section 06 — bring your own ----------------------------------------- */

const seams: { concern: string; providers: string; seam: string; included: string }[] = [
  {
    concern: 'Enterprise identity',
    providers: 'Okta · Entra · Keycloak',
    seam: 'An ash_authentication strategy federates OIDC today; SAML and SCIM are planned, not pretended.',
    included: 'Password and magic-link accounts with the full actor, role, and audit semantics.',
  },
  {
    concern: 'Analytics & BI',
    providers: 'Grafana · Superset',
    seam: 'BI tools read views already filtered by the same actor context; metrics and traces export over OpenTelemetry.',
    included: 'The Grafana LGTM backend, wired to the same spans the actions emit.',
  },
  {
    concern: 'Data ingestion',
    providers: 'Meltano',
    seam: 'Pipelines land normalized data in the warehouse; OpenLineage carries the lineage alongside it.',
    included: 'Contract and party projections from the legacy estate, running locally.',
  },
  {
    concern: 'Notification channels',
    providers: 'Your email & SMS gateways',
    seam: 'Delivery sits at the notifier edge; the audit log records the decision, not the send.',
    included: 'Swoosh email senders for confirmation and password reset.',
  },
];

/* --- Section 07 — doctrine ----------------------------------------------- */

const doctrines: { title: string; body: string; href: string }[] = [
  {
    title: 'Batteries are inherited, not installed.',
    body: 'A resource that forgets its audit trail should be the one that had to work at it. The base resource injects authorization, audit, tenancy, and lifecycle into every declaration, so the compliant path is the path of least resistance — and opting out is explicit, local, and greppable.',
    href: withBase('/docs/manifesto/04-batteries-are-inherited/'),
  },
  {
    title: 'Authorization is a union of grants.',
    body: 'Grants accumulate; nothing subtracts. A role, a share, or a hierarchy — any one path is sufficient, and no rule’s meaning depends on where it sits in the list. Deny rules would reintroduce the order-dependence that makes authorization impossible to reason about, so they are refused.',
    href: withBase('/docs/manifesto/03-authorization-is-data/'),
  },
  {
    title: 'Agents are users.',
    body: 'An agent gets no privileged mutation path. It calls the same actions, under the same policies, attributed to the human who asked — and its proposals wait for a person’s approval. The audit trail never has to admit a second, murkier notion of who did what.',
    href: withBase('/docs/manifesto/05-agents-are-users/'),
  },
];
---

<Base
  title="Ash Enterprise — say what the software must do"
  description="The framework for small senior teams and smart agents to build ambitious enterprise software. Declare the hard parts once. Inherit the controls. Derive the surfaces. Keep the code worth owning."
  bare={true}
  active="home"
>
  <div class="ae-home bg-ae-paper text-ae-ink">
    {/* 01 · The fold */}
    <Hero />

    {/* 02 · The leverage — intro, then Fig. 1 */}
    <section id="leverage" class="scroll-mt-24 border-t border-ae-rule pt-20 lg:pt-24">
      <div class={container}>
        <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
          <div>
            <p class={eyebrow}>Section 02 — the leverage</p>
            <h2 class={h2}>One declaration. Every enterprise concern.</h2>
          </div>
          <p class={`${lead} lg:pt-14`}>
            Every layer below is someone else’s solved problem. Ash Enterprise is
            the top stratum: a chosen subset of the Ash ecosystem, five
            first-party packages for the parts Ash leaves to the application, and
            the conventions that hold them together.
          </p>
        </div>
      </div>
      <div class={`${container} pt-14 pb-[88px]`}>
        <StackElevation />
      </div>
    </section>

    {/* 03 · The leverage specimen */}
    <section id="the-specimen" class="scroll-mt-24 border-t border-ae-rule py-20 lg:py-28">
      <div class={container}>
        <p class={eyebrow}>Section 03 — the specimen</p>
        <h2 class={h2}>What a declaration carries.</h2>
        <div class="mt-14">
          <SpecimenPlate />
        </div>
      </div>
    </section>

    {/* 04 · The team model */}
    <section id="team-model" class="scroll-mt-24 border-t border-ae-rule py-20 lg:py-28">
      <div class={container}>
        <p class={eyebrow}>Section 04 — the team model</p>
        <h2 class={h2}>
          Humans set direction. Agents multiply the work. The framework holds the
          line.
        </h2>

        <div class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-0">
          {
            teamColumns.map((col, i) => (
              <div
                class:list={[
                  'min-w-0',
                  i > 0 && 'border-t border-ae-rule pt-8 sm:border-t-0 sm:pt-0',
                  i > 0 && 'sm:border-l sm:border-ae-rule sm:pl-8',
                  i < teamColumns.length - 1 && 'sm:pr-8',
                ]}
              >
                <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ae-copper">
                  {col.label}
                </p>
                <h3 class="mt-4 font-sans text-lg font-medium text-ae-ink">
                  {col.title}
                </h3>
                <p class="mt-3 text-[15px] leading-[1.6] text-ae-ink/75 text-pretty">
                  {col.body}
                </p>
              </div>
            ))
          }
        </div>

        <a class={`${underlineLink} mt-14`} href={withBase('/docs/manifesto/05-agents-are-users/')}>
          Read the argument <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    {/* 05 · Capabilities */}
    <section id="capabilities" class="scroll-mt-24 border-t border-ae-rule py-20 lg:py-28">
      <div class={container}>
        <p class={eyebrow}>Section 05 — capabilities</p>
        <h2 class={h2}>
          The capabilities large customers ask for. Without a department for each
          one.
        </h2>

        <div class="mt-14">
          <div class="hidden grid-cols-[200px_minmax(0,1fr)_220px] gap-8 border-b border-ae-rule pb-3 lg:grid">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ae-blueprint">Capability</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ae-blueprint">What it buys</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ae-blueprint">Evidence</p>
          </div>

          {
            capabilities.map((cap) => (
              <div class="grid gap-3 border-t border-ae-rule py-7 lg:grid-cols-[200px_minmax(0,1fr)_220px] lg:items-baseline lg:gap-8">
                <h3 class="font-sans text-[15px] font-medium text-ae-ink">{cap.name}</h3>
                <p class="max-w-[60ch] text-[15px] leading-[1.6] text-ae-ink/75 text-pretty">
                  {cap.outcome}
                </p>
                <a class={underlineLink} href={cap.href}>
                  {cap.linkLabel}
                </a>
              </div>
            ))
          }
          <div class="border-t border-ae-rule" aria-hidden="true" />
        </div>
      </div>
    </section>

    {/* 06 · Bring your own */}
    <section id="bring-your-own" class="scroll-mt-24 border-t border-ae-rule py-20 lg:py-28">
      <div class={container}>
        <p class={eyebrow}>Section 06 — the seams</p>
        <h2 class={h2}>
          Bring your own identity. Your analytics. Your notification channels.
        </h2>
        <p class={lead}>
          Ash Enterprise is deliberately less opinionated where every enterprise
          already has an answer. It integrates at the seams instead of
          duplicating them — and includes a lightweight version only so the
          reference app runs standalone.
        </p>

        <div class="mt-14">
          <div class="hidden grid-cols-[minmax(0,0.8fr)_minmax(0,1.3fr)_minmax(0,1fr)] gap-8 border-b border-ae-rule pb-3 lg:grid">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ae-blueprint">Concern</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ae-blueprint">
              The seam Ash Enterprise exposes
            </p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ae-blueprint">
              Included lightweight version
            </p>
          </div>

          {
            seams.map((row) => (
              <div class="grid gap-3 border-t border-ae-rule py-7 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.3fr)_minmax(0,1fr)] lg:items-baseline lg:gap-8">
                <div>
                  <h3 class="font-sans text-[15px] font-medium text-ae-ink">{row.concern}</h3>
                  <p class="mt-1 font-mono text-[12px] text-ae-blueprint">{row.providers}</p>
                </div>
                <p class="max-w-[60ch] text-[15px] leading-[1.6] text-ae-ink/75 text-pretty">
                  {row.seam}
                </p>
                <p class="max-w-[48ch] text-[15px] leading-[1.6] text-ae-ink/75 text-pretty">
                  {row.included}
                </p>
              </div>
            ))
          }
          <div class="border-t border-ae-rule" aria-hidden="true" />
        </div>

        <a
          class={`${underlineLink} mt-10`}
          href={withBase('/docs/manifesto/07-what-we-do-not-have/#bring-your-own')}
        >
          Read the scope decisions <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    {/* 07 · Doctrine */}
    <section id="doctrine" class="scroll-mt-24 border-t border-ae-rule py-20 lg:py-28">
      <div class={container}>
        <p class={eyebrow}>Section 07 — doctrine</p>
        <h2 class={h2}>Strong opinions, held in code.</h2>

        <div class="mt-14">
          {
            doctrines.map((d) => (
              <div class="grid gap-4 border-t border-ae-rule py-10 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)_auto] lg:items-baseline lg:gap-10">
                <h3 class="font-display text-[26px] leading-[1.15] font-normal text-ae-ink">
                  {d.title}
                </h3>
                <p class="max-w-[62ch] text-[15px] leading-[1.6] text-ae-ink/75 text-pretty">
                  {d.body}
                </p>
                <a class={underlineLink} href={d.href}>
                  Read the argument <span aria-hidden="true">→</span>
                </a>
              </div>
            ))
          }
          <div class="border-t border-ae-rule" aria-hidden="true" />
        </div>
      </div>
    </section>

    {/* 08 · Closing */}
    <section id="begin" class="border-t border-ae-rule bg-ae-paper-2 py-24 lg:py-28">
      <div class={container}>
        <p class={eyebrow}>Section 08 — begin</p>
        <h2 class="mt-4 max-w-[980px] font-display text-[36px] leading-[1.08] tracking-[-0.015em] font-normal text-ae-ink lg:text-[48px]">
          Bring the application you have. Build the one your largest customer
          expects.
        </h2>
        <p class="mt-6 max-w-[640px] text-[19px] leading-[1.6] text-ae-ink text-pretty">
          Run the reference application, follow a real enterprise flow, and
          decide which parts are worth keeping.
        </p>

        <div class="mt-12 flex flex-wrap items-center gap-6">
          <a
            class="inline-flex items-center gap-[10px] rounded-[2px] bg-ae-vermilion px-7 py-4 font-sans text-base font-medium text-ae-paper transition-opacity duration-150 hover:opacity-90 dark:text-[#14160f]"
            href={withBase('/docs/manifesto/')}
          >
            Read the doctrine <span aria-hidden="true">→</span>
          </a>
          <a
            class="border-b border-ae-workshop px-1 py-4 font-sans text-base font-medium text-ae-workshop transition-colors duration-150 hover:border-ae-vermilion hover:text-ae-vermilion"
            href={GITHUB}
            target="_blank"
            rel="noopener noreferrer"
          >
            Clone the repository
          </a>
          <a class={`${underlineLink} px-1 py-4 text-base`} href={withBase('/proof/')}>
            Explore the proof <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  /*
   * Blueprint focus rings for this page's interactive elements, per the
   * handoff — scoped under the page root so the rest of the site keeps the
   * shared indigo ring from global.css.
   */
  .ae-home a:focus-visible,
  .ae-home button:focus-visible {
    outline: 2px solid var(--ae-blueprint);
    outline-offset: 2px;
    border-radius: 0;
  }
</style>

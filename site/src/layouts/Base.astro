---
/**
 * Base.astro — the shell for every page under `src/pages/`. Starlight renders
 * `/docs/*` with its own layout; the two share the `data-theme` attribute, the
 * `starlight-theme` localStorage key, the tokens in `styles/tokens.css` and the
 * fonts, so crossing between them changes nothing a reader can see but the
 * chrome.
 *
 *   ---
 *   import Base from '../layouts/Base.astro';
 *   import { withBase } from '../lib/roadmap';
 *   ---
 *   <Base title="Proof" description="…" active="proof">
 *     <a href={withBase('/docs/')}>Docs</a>
 *   </Base>
 *
 * Every internal href goes through `withBase`: the site is served under
 * `/ash_enterprise`, and a bare `/docs/` works in dev and 404s in production.
 */
import '../styles/global.css';

/*
 * Self-hosted fonts, no font CDN. `astro.config.mjs` hands Starlight the same
 * files through `customCss`, so the docs set the same type.
 */
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import Lightbox from '../components/Lightbox.astro';
import { withBase } from '../lib/roadmap';

/** The routes the primary navigation knows about, in reading order. */
type RouteKey = 'home' | 'platform' | 'packages' | 'proof' | 'run-it' | 'roadmap' | 'docs';

interface Props {
  title: string;
  description?: string;
  /** Set on the landing page only; other pages get `"<title> · Ash Enterprise"`. */
  bare?: boolean;
  /**
   * The route this page is, to mark its nav link. `product` is the old name of
   * `platform` and marks the same link.
   */
  active?: RouteKey | 'product';
}

const {
  title,
  description = 'A reference Ash/Phoenix enterprise application template: ownership, hierarchy, audit, tenancy and policy declared once, on every resource.',
  bare = false,
  active: activeProp,
} = Astro.props;

const active: RouteKey | undefined = activeProp === 'product' ? 'platform' : activeProp;

const pageTitle = bare ? title : `${title} · Ash Enterprise`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// Absolute, because a share card is fetched by a crawler that has no page to
// resolve a relative path against. Generated by `scripts/build-og.mjs`.
const ogImage = new URL(withBase('/og.png'), Astro.site ?? Astro.url).href;

/*
 * A nav link is only drawn for a page that is in this build, so the site never
 * links to its own 404. The glob runs at build time and costs nothing at run
 * time. `/docs/` is Starlight's and always exists. `/platform/` falls back to
 * `/product/`, its old address, until the page under the new name lands.
 */
const pageFiles = Object.keys(import.meta.glob('../pages/**/*.{astro,md,mdx}'));
const hasPage = (slug: string): boolean =>
  pageFiles.some((file) =>
    [`../pages/${slug}.astro`, `../pages/${slug}/index.astro`, `../pages/${slug}.md`, `../pages/${slug}.mdx`].includes(file),
  );

interface NavLink {
  key: RouteKey;
  label: string;
  href: string;
}

const candidates: (NavLink & { exists: boolean })[] = [
  {
    key: 'platform',
    label: 'Platform',
    href: withBase(hasPage('platform') ? '/platform/' : '/product/'),
    exists: hasPage('platform') || hasPage('product'),
  },
  { key: 'packages', label: 'Packages', href: withBase('/packages/'), exists: hasPage('packages') },
  { key: 'proof', label: 'Proof', href: withBase('/proof/'), exists: hasPage('proof') },
  { key: 'run-it', label: 'Run it', href: withBase('/run-it/'), exists: hasPage('run-it') },
  { key: 'roadmap', label: 'Roadmap', href: withBase('/roadmap/'), exists: hasPage('roadmap') },
  { key: 'docs', label: 'Docs', href: withBase('/docs/'), exists: true },
];

const nav: NavLink[] = candidates.filter((link) => link.exists);
const GITHUB = 'https://github.com/lukegalea/ash_enterprise';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ash Enterprise" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ash Enterprise — the cross-cutting concerns are declarable" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />

    {/*
      Blocking, before first paint, so the page never flashes the wrong theme.
      The key and the attribute are Starlight's: it stores 'light' | 'dark' |
      'auto' under `starlight-theme` and resolves `data-theme` to light or dark.
      Diverging from either would strand a reader in the wrong theme the moment
      they crossed between the landing page and the docs.
    */}
    <script is:inline>
      (() => {
        const KEY = 'starlight-theme';
        let stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch {
          /* private mode: fall through to the system preference */
        }
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <slot name="head" />
  </head>

  <body class="min-h-dvh bg-ae-paper text-ae-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-ae focus:bg-ae-paper focus:px-4 focus:py-2 focus:text-sm focus:shadow-ae"
    >
      Skip to content
    </a>

    <header class="ae-header sticky top-0 z-40 border-b border-ae-rule">
      <div class="ae-container flex h-16 items-center gap-4">
        <a
          href={withBase('/')}
          class="flex items-center gap-2.5 text-ae-ink transition-opacity hover:opacity-80"
          aria-current={active === 'home' ? 'page' : undefined}
        >
          <span
            class="grid h-7 w-7 place-items-center rounded-ae bg-ae-workshop font-mono text-[0.7rem] font-medium text-ae-on-accent"
            aria-hidden="true">AE</span
          >
          <span class="font-display text-[1.2rem] leading-none">Ash Enterprise</span>
        </a>

        {/* Wide screens: the links in a row. */}
        <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Primary">
          {
            nav.map((link) => (
              <a
                href={link.href}
                class="ae-nav-link"
                aria-current={active === link.key ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
          <a class="ae-nav-link" href={GITHUB} target="_blank" rel="noopener noreferrer">
            GitHub<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </nav>

        <button
          id="theme-toggle"
          type="button"
          class="ml-auto grid h-10 w-10 place-items-center rounded-ae border border-ae-rule text-ae-muted transition-colors hover:bg-ae-paper-2 hover:text-ae-ink lg:ml-2"
          aria-label="Switch between light and dark"
          title="Switch between light and dark"
        >
          <svg
            class="h-4 w-4 dark:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
          <svg
            class="hidden h-4 w-4 dark:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
          </svg>
        </button>

        {/*
          Narrow screens: a native disclosure. <details> opens and closes from the
          keyboard (Enter, Space) and is announced as expandable with no script at
          all; the small script below only adds Escape and close-on-navigate.
        */}
        <details id="ae-menu" class="ae-menu lg:hidden">
          <summary
            class="grid h-10 w-10 cursor-pointer place-items-center rounded-ae border border-ae-rule text-ae-ink transition-colors hover:bg-ae-paper-2"
            aria-label="Menu"
          >
            <svg class="ae-menu-open h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg class="ae-menu-close h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </summary>
          <nav class="ae-menu-panel border-b border-ae-rule bg-ae-paper" aria-label="Primary">
            <ul class="ae-container flex flex-col py-3">
              <li>
                <a class="ae-menu-link" href={withBase('/')} aria-current={active === 'home' ? 'page' : undefined}>
                  Overview
                </a>
              </li>
              {
                nav.map((link) => (
                  <li>
                    <a
                      class="ae-menu-link"
                      href={link.href}
                      aria-current={active === link.key ? 'page' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
              <li>
                <a class="ae-menu-link" href={GITHUB} target="_blank" rel="noopener noreferrer">
                  GitHub<span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-ae-rule">
      <div
        class="ae-container flex flex-col gap-5 py-10 text-sm text-ae-muted lg:flex-row lg:items-center lg:justify-between"
      >
        <p>
          <span class="font-medium text-ae-ink">Ash Enterprise</span> — a reference template, not a
          product. MIT licensed.
        </p>
        <nav aria-label="Footer">
          <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
            {
              nav.map((link) => (
                <li>
                  <a class="transition-colors hover:text-ae-ink" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="transition-colors hover:text-ae-ink" href={GITHUB} target="_blank" rel="noopener noreferrer"
                >GitHub<span class="sr-only"> (opens in a new tab)</span></a
              >
            </li>
            <li aria-hidden="true">{year}</li>
          </ul>
        </nav>
      </div>
    </footer>

    {/*
      One dialog for every figure on the page, and it costs a page with no
      figures nothing but its own markup: the script delegates from `document`
      and exits immediately if the dialog is missing or `showModal` is not a
      function. Declared here rather than in each page so a figure added later
      is lightboxable without anyone remembering this exists.
    */}
    <Lightbox />

    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        if (!button) return;
        button.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            // Same key Starlight reads, so the docs honour this choice too.
            localStorage.setItem('starlight-theme', next);
          } catch {
            /* nothing to persist to; the in-page toggle still works */
          }
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const menu = document.getElementById('ae-menu');
        if (!menu) return;
        const summary = menu.querySelector('summary');
        // Escape closes the menu and hands focus back to its button.
        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu.open) {
            menu.open = false;
            summary?.focus();
          }
        });
        // Following an in-page link leaves the menu open over the target otherwise.
        menu.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
        });
        // Growing past the breakpoint with the menu open would strand it.
        window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
          if (event.matches) menu.open = false;
        });
      })();
    </script>
  </body>
</html>

<style>
  .ae-header {
    background-color: color-mix(in oklab, var(--ae-paper) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  .ae-nav-link {
    border-radius: var(--ae-radius);
    padding: 0.5rem 0.75rem;
    font-size: var(--ae-text-small);
    font-weight: 500;
    color: var(--ae-blueprint);
    transition: color 150ms ease, background-color 150ms ease;
  }

  .ae-nav-link:hover {
    background-color: var(--ae-paper-2);
    color: var(--ae-ink);
  }

  .ae-nav-link[aria-current='page'] {
    color: var(--ae-ink);
    box-shadow: inset 0 -2px 0 var(--ae-workshop);
  }

  /* The disclosure: the summary is the button, the panel drops below the bar. */
  .ae-menu > summary {
    list-style: none;
  }

  .ae-menu > summary::-webkit-details-marker {
    display: none;
  }

  .ae-menu .ae-menu-close,
  .ae-menu[open] .ae-menu-open {
    display: none;
  }

  .ae-menu[open] .ae-menu-close {
    display: block;
  }

  .ae-menu-panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    box-shadow: var(--ae-shadow);
  }

  .ae-menu-link {
    display: block;
    border-top: 1px solid var(--ae-rule);
    padding-block: 0.875rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ae-ink);
  }

  li:first-child > .ae-menu-link {
    border-top: 0;
  }

  .ae-menu-link[aria-current='page'] {
    color: var(--ae-workshop);
  }

  .ae-menu-link[aria-current='page']::before {
    content: '';
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    margin-right: 0.625rem;
    vertical-align: middle;
    background-color: var(--ae-workshop);
  }
</style>

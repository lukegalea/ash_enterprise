---
/**
 * Base.astro — the shell for pages under `src/pages/` (the landing page and the
 * roadmap). Starlight renders `/docs/*` with its own layout; this exists so the
 * marketing pages match it on the things that must match: the `data-theme`
 * attribute, the `starlight-theme` localStorage key, and the colour tokens.
 *
 * Usage:
 *
 *   ---
 *   import Base from '../layouts/Base.astro';
 *   import { withBase } from '../lib/roadmap';
 *   ---
 *   <Base title="Ash Enterprise" description="…">
 *     <a href={withBase('/docs/')}>Docs</a>
 *   </Base>
 *
 * Every internal href must go through `withBase` — see `src/README` notes.
 */
import '../styles/global.css';
import Lightbox from '../components/Lightbox.astro';
import { withBase } from '../lib/roadmap';

interface Props {
  title: string;
  description?: string;
  /** Set on the landing page only; other pages get `"<title> · Ash Enterprise"`. */
  bare?: boolean;
  /** Path of the current page, used to mark the active nav link. */
  active?: 'home' | 'docs' | 'roadmap' | 'vision' | 'controls';
}

const {
  title,
  description = 'A reference Ash/Phoenix enterprise application template: ownership, hierarchy, audit, tenancy and policy declared once, on every resource.',
  bare = false,
  active,
} = Astro.props;

const pageTitle = bare ? title : `${title} · Ash Enterprise`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// Absolute, because a share card is fetched by a crawler that has no page to
// resolve a relative path against. Generated by `scripts/build-og.mjs` from the
// same ledger as the rest of the site, so the first thing a stranger sees is the
// current scoreboard rather than a slogan that has drifted.
const ogImage = new URL(withBase('/og.png'), Astro.site ?? Astro.url).href;

const nav: { key: string; label: string; href: string; external: boolean }[] = [
  { key: 'vision', label: 'Vision', href: withBase('/vision/'), external: false },
  { key: 'controls', label: 'Controls', href: withBase('/controls/'), external: false },
  { key: 'docs', label: 'Docs', href: withBase('/docs/'), external: false },
  { key: 'roadmap', label: 'Roadmap', href: withBase('/roadmap/'), external: false },
  {
    key: 'github',
    label: 'GitHub',
    href: 'https://github.com/lukegalea/ash_enterprise',
    external: true,
  },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ash Enterprise" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ash Enterprise — the cross-cutting concerns are declarable" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />

    {/*
      Blocking, before first paint, so the page never flashes the wrong theme.
      The key and the attribute are Starlight's: it stores 'light' | 'dark' |
      'auto' under `starlight-theme` and resolves `data-theme` to light or dark.
      Diverging from either would strand a reader in the wrong theme the moment
      they crossed between the landing page and the docs.
    */}
    <script is:inline>
      (() => {
        const KEY = 'starlight-theme';
        let stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch {
          /* private mode: fall through to the system preference */
        }
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <slot name="head" />
  </head>

  <body class="min-h-dvh bg-bg text-fg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:shadow-card"
    >
      Skip to content
    </a>

    <header
      class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/70"
    >
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6 lg:px-8">
        <a
          href={withBase('/')}
          class="flex items-center gap-2 font-semibold tracking-tight text-fg transition-opacity hover:opacity-80"
          aria-current={active === 'home' ? 'page' : undefined}
        >
          <span
            class="grid h-7 w-7 place-items-center rounded-md bg-brand text-[0.7rem] font-bold text-brand-fg"
            aria-hidden="true">AE</span
          >
          <span>Ash Enterprise</span>
        </a>

        <nav class="ml-auto flex items-center gap-1 text-sm" aria-label="Primary">
          {
            nav.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'rounded-md px-3 py-2 font-medium transition-colors hover:bg-surface-2',
                  active === link.key ? 'text-fg' : 'text-muted hover:text-fg',
                ]}
                aria-current={active === link.key ? 'page' : undefined}
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
              </a>
            ))
          }

          <button
            id="theme-toggle"
            type="button"
            class="ml-1 grid h-9 w-9 place-items-center rounded-md border border-line text-muted transition-colors hover:bg-surface-2 hover:text-fg"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <svg
              class="h-4 w-4 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path>
            </svg>
            <svg
              class="hidden h-4 w-4 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
      >
        <p>
          <span class="font-medium text-fg">Ash Enterprise</span> — a reference template, not a
          product. MIT licensed.
        </p>
        <nav class="flex items-center gap-5" aria-label="Footer">
          <a class="transition-colors hover:text-fg" href={withBase('/docs/')}>Docs</a>
          <a class="transition-colors hover:text-fg" href={withBase('/docs/questions/')}>Checklist</a
          >
          <a
            class="transition-colors hover:text-fg"
            href="https://github.com/lukegalea/ash_enterprise"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
          <span aria-hidden="true">·</span>
          <span>{year}</span>
        </nav>
      </div>
    </footer>

    {/*
      One dialog for every figure on the page, and it costs a page with no
      figures nothing but its own markup: the script delegates from `document`
      and exits immediately if the dialog is missing or `showModal` is not a
      function. Declared here rather than in each page so a figure added later
      is lightboxable without anyone remembering this exists.
    */}
    <Lightbox />

    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        if (!button) return;
        button.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            // Same key Starlight reads, so the docs honour this choice too.
            localStorage.setItem('starlight-theme', next);
          } catch {
            /* nothing to persist to; the in-page toggle still works */
          }
        });
      })();
    </script>
  </body>
</html>

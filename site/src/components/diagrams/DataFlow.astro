---
/**
 * What one write does, from the request to the evidence, as the code does it.
 * Every step names the module or command that performs it, and links to it;
 * nothing here is planned work. Read top to bottom: the request, the action,
 * the one transaction the row and its audit event share, what happens after
 * the commit, and how the record is read back.
 *
 * Sources: `AshEnterpriseWeb.Plugs.LoadActorContext`,
 * `AshEnterprise.Security.Policies`, `AshEnterprise.Audit.EventLog` (and the
 * `audit_events` triggers in `priv/repo/migrations/*tamper_evident_audit_log*`),
 * `AshEnterprise.Audit.Changes.RedactSensitive`,
 * `AshEnterprise.Platform.Correlation`, `AshEnterprise.Lineage.Transport`,
 * the `audit.verify` and `audit.export` mix tasks and `AshEnterprise.Erasure`.
 *
 * HTML, not one SVG: a single column with a rail on its left reads at phone
 * width without shrinking the text, and every colour is a token.
 */
import { repoHref } from '../../lib/roadmap';

interface Props {
  caption?: string;
  class?: string;
}

const {
  caption = 'Fig. — One write, end to end. The row and its audit event commit together or not at all; the span and the lineage event follow the commit and never fail it.',
  class: className = '',
} = Astro.props;

interface Step {
  title: string;
  body: string;
  /** Module, table or command, printed in mono. */
  what: string;
  path?: string;
}

interface Stage {
  label: string;
  steps: Step[];
  /** Drawn as one boxed group: the transaction. */
  boxed?: string;
}

const stages: Stage[] = [
  {
    label: 'Request',
    steps: [
      {
        title: 'The actor’s context is built once',
        body: 'Teams, the business-unit subtree, the privilege map and the reporting chain, loaded before any action runs. A correlation id is started for the request.',
        what: 'Plugs.LoadActorContext',
        path: 'lib/ash_enterprise_web/plugs/load_actor_context.ex',
      },
    ],
  },
  {
    label: 'Action',
    steps: [
      {
        title: 'Policies decide from that context',
        body: 'The grant union and the narrowed bypasses read the precomputed sets. A check that queries is a bug.',
        what: 'Security.Policies',
        path: 'lib/ash_enterprise/security/policies.ex',
      },
    ],
  },
  {
    label: 'Commit',
    boxed: 'One database transaction',
    steps: [
      {
        title: 'The row is written',
        body: 'Owner, tenant and provenance columns are stamped by the platform, not by the caller.',
        what: 'Platform.SystemAttributes',
        path: 'lib/ash_enterprise/platform/system_attributes.ex',
      },
      {
        title: 'The tenant’s advisory lock is taken',
        body: 'ash_events serialises audited writes per tenant, so within a tenant the event sequence is commit order.',
        what: 'pg_advisory_xact_lock',
        path: 'lib/ash_enterprise/audit/event_log.ex',
      },
      {
        title: 'The audit event is inserted',
        body: 'Action name, actor or named system actor, correlation id and the changed attributes. A sensitive value is recorded as nil, its key kept.',
        what: 'Audit.EventLog · RedactSensitive',
        path: 'lib/ash_enterprise/audit/event_log.ex',
      },
      {
        title: 'A trigger chains it',
        body: 'Postgres stores the SHA-256 of the event with the hash of the tenant’s previous one. A second trigger makes UPDATE and DELETE on the log raise.',
        what: 'audit_events_chain · audit_events_immutable',
        path: 'priv/repo/migrations/20260819010542_tamper_evident_audit_log.exs',
      },
    ],
  },
  {
    label: 'After',
    steps: [
      {
        title: 'A span carries the same correlation id',
        body: 'Every action is an OpenTelemetry span with ash.correlation_id. Nothing is exported until an OTLP endpoint is configured.',
        what: 'OpentelemetryAsh · ash.correlation_id',
        path: 'telemetry/lib/ash_enterprise/telemetry/attributes.ex',
      },
      {
        title: 'A lineage run event is recorded',
        body: 'An OpenLineage COMPLETE event goes to the lineage store, and to an HTTP backend only when one is configured. Its failure never fails the write.',
        what: 'Lineage.Transport',
        path: 'lib/ash_enterprise/lineage/transport.ex',
      },
    ],
  },
  {
    label: 'Evidence',
    steps: [
      {
        title: 'Verify the chain',
        body: 'Walks every tenant’s chain and reports each break by sequence number.',
        what: 'mix ash_enterprise.audit.verify',
        path: 'lib/mix/tasks/ash_enterprise.audit.verify.ex',
      },
      {
        title: 'Export a window',
        body: 'One tenant’s events for a date range, as the sample an auditor asks for.',
        what: 'mix ash_enterprise.audit.export',
        path: 'lib/mix/tasks/ash_enterprise.audit.export.ex',
      },
      {
        title: 'Erase by destroying a key',
        body: 'Third-party content reaches the log only as ciphertext under its scope’s key. Shredding the key makes it unreadable; no event is deleted.',
        what: 'Erasure.shred_scope/4',
        path: 'lib/ash_enterprise/erasure.ex',
      },
    ],
  },
];
---

<figure class:list={['ae-df', className]}>
  <ol class="ae-df-stages">
    {
      stages.map((stage) => (
        <li class="ae-df-stage">
          <p class="ae-df-label">{stage.label}</p>
          <div class:list={['ae-df-body', stage.boxed && 'ae-df-boxed']}>
            {stage.boxed && <p class="ae-df-boxed-label">{stage.boxed}</p>}
            <ul class:list={['ae-df-steps', stage.steps.length > 1 && 'ae-df-steps-many']}>
              {stage.steps.map((step) => (
                <li class="ae-df-step">
                  <p class="ae-df-title">{step.title}</p>
                  <p class="ae-df-text">{step.body}</p>
                  {step.path ? (
                    <a class="ae-df-what" href={repoHref(step.path)} target="_blank" rel="noopener noreferrer">
                      {step.what}
                      <span class="sr-only"> (source, opens in a new tab)</span>
                    </a>
                  ) : (
                    <span class="ae-df-what">{step.what}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>

  {caption && <figcaption class="ae-df-caption">{caption}</figcaption>}
</figure>

<style>
  .ae-df {
    margin: 0;
  }

  .ae-df-stages {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The rail: a line down the left with a node at each stage. */
  .ae-df-stage {
    position: relative;
    padding-left: 1.75rem;
    padding-bottom: 1.75rem;
  }

  .ae-df-stage::before {
    content: '';
    position: absolute;
    left: 0.3125rem;
    top: 0.5rem;
    bottom: -0.5rem;
    border-left: 1.5px solid var(--ae-rule-strong);
  }

  .ae-df-stage:last-child::before {
    display: none;
  }

  .ae-df-stage::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 0.75rem;
    height: 0.75rem;
    border: 1.5px solid var(--ae-workshop);
    background-color: var(--ae-paper);
  }

  .ae-df-label {
    font-family: var(--ae-font-mono);
    font-size: var(--ae-text-label);
    letter-spacing: var(--ae-tracking-label);
    text-transform: uppercase;
    color: var(--ae-copper);
  }

  .ae-df-body {
    margin-top: 0.625rem;
  }

  .ae-df-boxed {
    border: 1.5px dashed var(--ae-workshop);
    border-radius: var(--ae-radius);
    padding: 0.75rem;
  }

  .ae-df-boxed-label {
    margin-bottom: 0.625rem;
    font-family: var(--ae-font-mono);
    font-size: 0.75rem;
    color: var(--ae-workshop);
  }

  .ae-df-steps {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ae-df-step {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--ae-rule);
    border-radius: var(--ae-radius);
    background-color: var(--ae-paper);
    padding: 0.75rem 0.875rem;
  }

  .ae-df-title {
    font-weight: 500;
    color: var(--ae-ink);
  }

  .ae-df-text {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ae-muted);
  }

  .ae-df-what {
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--ae-font-mono);
    font-size: 0.75rem;
    color: var(--ae-blueprint);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
  }

  a.ae-df-what:hover {
    color: var(--ae-ink);
    text-decoration-color: currentColor;
  }

  .ae-df-caption {
    max-width: var(--ae-measure);
    font-size: var(--ae-text-small);
    line-height: 1.55;
    color: var(--ae-blueprint);
  }

  @media (min-width: 48rem) {
    .ae-df-stage {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 1.5rem;
    }

    .ae-df-body {
      margin-top: 0;
    }

    .ae-df-steps-many {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }

    /* The transaction's four steps read as two pairs: write and lock, event and chain. */
    .ae-df-boxed .ae-df-steps-many {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
/**
 * Where data comes from and where it goes: ingestion, the promotion step that
 * is the only place ingested rows acquire ownership, and the three consumers
 * downstream of the action layer.
 *
 * Two things are drawn rather than glossed:
 *  - the authorization boundary, with Meltano deliberately *outside* it, and
 *  - the hole. Neither Meltano nor Airbyte emits OpenLineage, so the edge from
 *    ingestion into the lineage graph does not exist. ADR 0008's argument
 *    applies: a diagram that omits an edge it could not work out is worse than
 *    no diagram, because the reader cannot tell "nothing feeds this" from "the
 *    generator gave up". So the missing edge is drawn, and drawn as missing.
 *
 * Status words come from `roadmap.json` via the caller — never from this file.
 */
import { statusMeta, type Status } from '../../lib/roadmap';

interface Props {
  ingestion: Status;
  lineage: Status;
  catalog: Status;
  bi: Status;
  class?: string;
}

const { ingestion, lineage, catalog, bi, class: className = '' } = Astro.props;

const consumers = [
  {
    x: 60,
    title: 'Marquez',
    role: 'lineage',
    detail: 'OpenLineage runId is the correlation id',
    status: lineage,
  },
  {
    x: 330,
    title: 'OpenMetadata',
    role: 'catalog',
    detail: 'pushed alongside mix ash.codegen',
    status: catalog,
  },
  {
    x: 600,
    title: 'Superset',
    role: 'analytics',
    detail: 'tenant-scoped views from ActorContext',
    status: bi,
  },
];
---

<div class:list={['overflow-guard', className]}>
  <svg
    viewBox="0 0 900 432"
    role="img"
    aria-labelledby="dataflow-title dataflow-desc"
    class="block w-full min-w-[760px] text-fg"
    style="max-width:100%"
  >
    <title id="dataflow-title">Ingestion, promotion, and the three consumers downstream</title>
    <desc id="dataflow-desc">
      External sources feed Meltano, which lands rows in a staging schema outside the boundary
      where authorization applies. Promotion out of staging is an ordinary Ash action — the only
      place ingested data acquires ownership, tenancy and audit. Downstream of the action layer sit
      Marquez for lineage, OpenMetadata for cataloguing and Superset for analytics. The edge from
      ingestion into the lineage graph is drawn as broken, because neither Meltano nor Airbyte
      emits OpenLineage events.
    </desc>

    <defs>
      <marker
        id="df-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ae-line-strong)"></path>
      </marker>
      <marker
        id="df-arrow-brand"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ae-brand)"></path>
      </marker>
    </defs>

    {/* ---------- Outside the boundary ---------- */}
    <rect
      x="60"
      y="28"
      width="150"
      height="62"
      rx="9"
      fill="var(--ae-surface-2)"
      stroke="var(--ae-line-strong)"
      stroke-width="1.25"
      stroke-dasharray="5 4"></rect>
    <text x="135" y="54" font-size="13.5" text-anchor="middle" font-weight="600" fill="currentColor"
      >External sources</text
    >
    <text x="135" y="72" font-size="11" text-anchor="middle" fill="var(--ae-fg-muted)"
      >SaaS · files · other databases</text
    >

    <rect
      x="240"
      y="28"
      width="170"
      height="62"
      rx="9"
      fill="var(--ae-surface)"
      stroke="var(--ae-line-strong)"
      stroke-width="1.25"></rect>
    <text
      x="325"
      y="52"
      font-size="13.5"
      text-anchor="middle"
      font-weight="600"
      fill="currentColor"
      font-family="var(--font-mono)">Meltano</text
    >
    <text x="325" y="70" font-size="11" text-anchor="middle" fill="var(--ae-fg-muted)"
      >extract &amp; load · {statusMeta[ingestion].label}</text
    >

    <rect
      x="445"
      y="28"
      width="200"
      height="62"
      rx="9"
      fill="var(--ae-surface)"
      stroke="var(--ae-line-strong)"
      stroke-width="1.25"></rect>
    <text x="545" y="52" font-size="13.5" text-anchor="middle" font-weight="600" fill="currentColor"
      >staging schema</text
    >
    <text x="545" y="70" font-size="11" text-anchor="middle" fill="var(--ae-fg-muted)"
      >unauthorized at rest, on purpose</text
    >

    <text x="668" y="52" font-size="11.5" fill="var(--ae-fg-muted)">No second copy of the</text>
    <text x="668" y="68" font-size="11.5" fill="var(--ae-fg-muted)">security model lives here.</text>

    <path
      d="M 210 59 L 234 59"
      stroke="var(--ae-line-strong)"
      stroke-width="1.5"
      marker-end="url(#df-arrow)"></path>
    <path
      d="M 410 59 L 439 59"
      stroke="var(--ae-line-strong)"
      stroke-width="1.5"
      marker-end="url(#df-arrow)"></path>

    {/* ---------- The boundary ---------- */}
    <line
      x1="44"
      y1="126"
      x2="884"
      y2="126"
      stroke="var(--ae-brand)"
      stroke-width="1.5"
      stroke-dasharray="7 6"
      opacity="0.75"></line>
    <text x="884" y="118" font-size="11" text-anchor="end" fill="var(--ae-brand)"
      >the boundary where authorization applies</text
    >

    <path
      d="M 545 90 L 545 144"
      stroke="var(--ae-brand)"
      stroke-width="1.75"
      marker-end="url(#df-arrow-brand)"></path>

    {/* ---------- Promotion ---------- */}
    <rect
      x="240"
      y="150"
      width="405"
      height="58"
      rx="9"
      fill="var(--ae-brand-soft)"
      stroke="var(--ae-brand)"
      stroke-width="1.5"></rect>
    <text x="442" y="174" font-size="13.5" text-anchor="middle" font-weight="600" fill="currentColor"
      >Promotion is an ordinary Ash action</text
    >
    <text x="442" y="192" font-size="11" text-anchor="middle" fill="var(--ae-fg-muted)"
      >the only place ingested rows acquire ownership, tenancy and audit</text
    >

    <path
      d="M 442 208 L 442 229"
      stroke="var(--ae-line-strong)"
      stroke-width="1.5"
      marker-end="url(#df-arrow)"></path>

    {/* ---------- The action layer ---------- */}
    <rect
      x="60"
      y="235"
      width="780"
      height="62"
      rx="9"
      fill="var(--ae-surface)"
      stroke="var(--ae-line-strong)"
      stroke-width="1.75"></rect>
    <text x="450" y="260" font-size="14" text-anchor="middle" font-weight="600" fill="currentColor"
      >Ash action → ActorContext → policies → audit log</text
    >
    <text x="450" y="279" font-size="11" text-anchor="middle" fill="var(--ae-fg-muted)"
      >one correlation id threaded through every effect</text
    >

    {/* ---------- Consumers ---------- */}
    {
      consumers.map(({ x, title, role, detail, status }) => (
        <g>
          <path
            d={`M ${x + 120} 297 L ${x + 120} 329`}
            stroke="var(--ae-line-strong)"
            stroke-width="1.5"
            marker-end="url(#df-arrow)"
          />
          <rect
            x={x}
            y={335}
            width="240"
            height="70"
            rx="9"
            fill="var(--ae-surface-2)"
            stroke="var(--ae-line-strong)"
            stroke-width="1.25"
          />
          <text
            x={x + 16}
            y={360}
            font-size="13.5"
            font-weight="600"
            fill="currentColor"
            font-family="var(--font-mono)"
          >
            {title}
          </text>
          <text x={x + 224} y={360} font-size="11" text-anchor="end" fill="var(--ae-fg-muted)">
            {role} · {statusMeta[status].label}
          </text>
          <text x={x + 16} y={382} font-size="11" fill="var(--ae-fg-muted)">
            {detail}
          </text>
        </g>
      ))
    }

    {/* ---------- The hole, drawn as a hole ---------- */}
    <path
      d="M 240 76 H 34 Q 28 76 28 82 V 196"
      fill="none"
      stroke="var(--ae-line-strong)"
      stroke-width="1.25"
      stroke-dasharray="4 5"></path>
    <path
      d="M 28 234 V 364 Q 28 370 34 370 H 54"
      fill="none"
      stroke="var(--ae-line-strong)"
      stroke-width="1.25"
      stroke-dasharray="4 5"
      marker-end="url(#df-arrow)"></path>

    <circle cx="28" cy="215" r="10" fill="var(--ae-bg)" stroke="var(--ae-line-strong)"
      stroke-width="1.25"></circle>
    <path
      d="M 23 210 L 33 220 M 33 210 L 23 220"
      stroke="var(--ae-fg-muted)"
      stroke-width="1.5"
      stroke-linecap="round"></path>

    <text x="48" y="211" font-size="11.5" fill="var(--ae-fg-muted)"
      >Meltano emits no OpenLineage.</text
    >
    <text x="48" y="227" font-size="11.5" fill="var(--ae-fg-muted)"
      >The hole is drawn as a hole.</text
    >
  </svg>
</div>

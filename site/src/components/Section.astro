---
/**
 * One section of a page: an eyebrow (optionally numbered), a display heading,
 * an optional lead, an optional row of status chips and an aside, then the
 * body. The page's rhythm comes from here, so pages do not restate it.
 *
 *   <Section id="control" step="01" eyebrow="Control" title="Who may do what" lead="…">
 *     <StatusChip slot="chips" status={…} label="…" />
 *     …body…
 *   </Section>
 *
 * `tone="muted"` paints the band in `paper-2` so consecutive sections do not
 * read as one scroll; use it about every third section. `wide` widens the
 * column for tables and diagrams.
 */
interface Props {
  id: string;
  /** Two-digit step in the page's argument, e.g. `04`. */
  step?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  tone?: 'default' | 'muted';
  wide?: boolean;
  /** Heading level for the title; 2 unless the page has no other h2 above. */
  level?: 2 | 3;
  class?: string;
}

const {
  id,
  step,
  eyebrow,
  title,
  lead,
  tone = 'default',
  wide = false,
  level = 2,
  class: className = '',
} = Astro.props;

const Heading = level === 3 ? 'h3' : 'h2';
const hasChips = Astro.slots.has('chips');
const hasAside = Astro.slots.has('aside');
---

<section
  id={id}
  class:list={['ae-section', tone === 'muted' && 'bg-ae-paper-2', className]}
>
  <div class={wide ? 'ae-container' : 'ae-container-narrow'}>
    <header class="max-w-3xl">
      {
        (step || eyebrow) && (
          <p class="ae-eyebrow mb-4 flex items-center gap-3">
            {step && (
              <span class="border border-ae-rule px-1.5 py-0.5 tabular-nums">{step}</span>
            )}
            {eyebrow && <span>{eyebrow}</span>}
          </p>
        )
      }

      <Heading class="ae-h2">{title}</Heading>

      {lead && <p class="ae-lead mt-5">{lead}</p>}

      {
        hasChips && (
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <slot name="chips" />
          </div>
        )
      }
    </header>

    {
      hasAside && (
        <div class="ae-body mt-6 border-l-2 border-ae-workshop/40 pl-5">
          <slot name="aside" />
        </div>
      )
    }

    <div class="mt-12">
      <slot />
    </div>
  </div>
</section>

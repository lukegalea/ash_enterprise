---
/**
 * The headline number and the four-status tally, both computed from
 * `docs/roadmap.json`. If a question flips to shipped in the repo, this line
 * changes on the next build and nowhere else has to be edited.
 */
import StatusIcon from './StatusIcon.astro';
import { deliveryStatuses, statusLabel } from './status';
import { counts } from '../lib/roadmap';

interface Props {
  /** `hero` is the large treatment; `inline` is the compact one. */
  variant?: 'hero' | 'inline';
  class?: string;
}

const { variant = 'hero', class: className = '' } = Astro.props;
const tally = counts();
---

{
  variant === 'hero' ? (
    <div class:list={['ae-card p-6', className]}>
      <p class="text-sm text-ae-muted">
        <span class="font-display text-4xl text-ae-ink tabular-nums">{tally.shipped}</span>
        <span class="font-display text-4xl text-ae-muted tabular-nums"> / {tally.total}</span>
        <span class="ml-2">enterprise questions have a shipped answer.</span>
      </p>

      <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {deliveryStatuses.map((status) => (
          <div class="border border-ae-rule bg-ae-paper-2 px-3 py-2.5">
            <dt class="flex items-center gap-1.5 text-xs font-medium text-ae-muted">
              <StatusIcon status={status} size={12} />
              {statusLabel[status]}
            </dt>
            <dd class="mt-1 text-xl font-semibold tabular-nums">{tally[status]}</dd>
          </div>
        ))}
      </dl>

      <p class="mt-4 text-xs leading-relaxed text-ae-muted">
        Counted at build time from <code class="ae-code">docs/roadmap.json</code>, the same file the
        README and the checklist render from.
      </p>
    </div>
  ) : (
    <dl class:list={['flex flex-wrap items-center gap-x-5 gap-y-2 text-sm', className]}>
      {deliveryStatuses.map((status) => (
        <div class="flex items-center gap-1.5">
          <dt class="flex items-center gap-1.5 text-ae-muted">
            <StatusIcon status={status} size={12} />
            {statusLabel[status]}
          </dt>
          <dd class="font-semibold tabular-nums">{tally[status]}</dd>
        </div>
      ))}
    </dl>
  )
}

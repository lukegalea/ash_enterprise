---
/**
 * A code specimen on paper: the Atelier plate. Paper ground, hairline rule,
 * square corners, IBM Plex Mono at 14px/1.75, coloured from the `--ae-*`
 * tokens so it follows the theme. Elixir is tokenised; any other language is
 * set in plain ink rather than half-right highlighting.
 *
 * For code shown as evidence (a real file, captioned, dark in both themes)
 * use `Exhibit.astro` instead.
 */
interface Props {
  code: string;
  lang?: string;
  /** Shown in the title bar; usually a path or a shell prompt label. */
  filename?: string;
  class?: string;
}

const { code, lang = 'elixir', filename, class: className = '' } = Astro.props;

/* --- Atelier token map --------------------------------------------------- */
/*
 * The handoff's specimen spec, one entry per token kind. Colours are the
 * `--ae-*` variables so light and dark resolve from the same map. Keyword-list
 * keys (`domain:`, `allow_nil?:`) deliberately stay ink — the design colours
 * only leading-colon atoms.
 */
const escapeHtml = (value: string): string =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const ATELIER_TOKEN_MAP: Record<string, string> = {
  keyword: 'color: var(--ae-workshop)',
  string: 'color: var(--ae-copper)',
  atom: 'color: var(--ae-blueprint)',
  boolean: 'color: var(--ae-vermilion)',
  comment: 'color: var(--ae-blueprint); font-style: italic',
};

const ATELIER_KEYWORDS = 'defmodule|defmacro|use|do|end';
const ATELIER_TOKEN_RE = new RegExp(
  // strings | comments | atoms | booleans | keywords — in that order, so a
  // `#` inside a string is a string and `:true` is an atom, not a boolean.
  `("(?:[^"\\\\]|\\\\.)*")` +
    `|(#[^\\n]*)` +
    `|(:[a-zA-Z_][a-zA-Z0-9_]*[?!]?)` +
    `|\\b(true|false)\\b` +
    `|\\b(${ATELIER_KEYWORDS})\\b`,
  'g',
);

function highlightAtelierElixir(source: string): string {
  let out = '';
  let last = 0;
  for (const match of source.matchAll(ATELIER_TOKEN_RE)) {
    const index = match.index ?? 0;
    out += escapeHtml(source.slice(last, index));
    const [full, strTok, commentTok, atomTok, boolTok, keywordTok] = match;
    const style = strTok
      ? ATELIER_TOKEN_MAP.string
      : commentTok
        ? ATELIER_TOKEN_MAP.comment
        : atomTok
          ? ATELIER_TOKEN_MAP.atom
          : boolTok
            ? ATELIER_TOKEN_MAP.boolean
            : keywordTok
              ? ATELIER_TOKEN_MAP.keyword
              : '';
    out += `<span style="${style}">${escapeHtml(full)}</span>`;
    last = index + full.length;
  }
  return out + escapeHtml(source.slice(last));
}

const html = lang === 'elixir' ? highlightAtelierElixir(code.trim()) : escapeHtml(code.trim());
---

<div class:list={['ae-codepanel min-w-0 overflow-hidden rounded-ae border border-ae-rule bg-ae-paper', className]}>
  {
    filename && (
      <div class="flex items-center gap-2 border-b border-ae-rule px-4 py-2.5">
        <span class="font-mono text-xs tracking-wide text-ae-copper">{filename}</span>
      </div>
    )
  }
  {/* Focusable so a keyboard can scroll a line wider than the column. */}
  <div class="ae-overflow" tabindex="0" {...(filename ? { role: 'region', 'aria-label': `Code: ${filename}` } : {})}>
    <pre
      class="px-5 py-6 font-mono text-[13px] leading-[1.75] whitespace-pre text-ae-ink sm:px-[30px] sm:py-[28px] sm:text-[14px]"
      set:html={html}
    />
  </div>
</div>

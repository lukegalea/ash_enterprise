---
/**
 * An animated capture that is allowed not to exist.
 *
 * The sibling of `ScreenshotFigure.astro`, and separate from it for one
 * concrete reason: that component renders through `astro:assets`, which hands
 * the file to sharp, and sharp re-encodes an animated GIF down to its first
 * frame. An animation shown that way is silently just a screenshot — it looks
 * fine in review and proves nothing.
 *
 * So this emits a plain `<img>` against the bundled URL, with `width` and
 * `height` set so the page does not reflow while it loads.
 */
import { animation } from './screenshots';
import ZoomBadge from './ZoomBadge.astro';

interface Props {
  /** Bare filename inside `src/assets/screenshots/`, e.g. `legacy-live-update.gif`. */
  name: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
  class?: string;
  /** Rendered when the capture is absent, instead of nothing. */
  fallback?: boolean;
}

const {
  name,
  alt,
  caption,
  width,
  height,
  class: className = '',
  fallback = false,
} = Astro.props;

const src = animation(name);
const hasCaption = Boolean(caption || Astro.slots.has('default'));
---

{
  src ? (
    <figure class:list={['group my-0', className]}>
      <div class="overflow-hidden rounded-ae border border-ae-rule bg-ae-paper shadow-ae transition-shadow duration-300 group-hover:shadow-lg">
        <div
          class="flex items-center gap-1.5 border-b border-ae-rule bg-ae-paper-2 px-3 py-2"
          aria-hidden="true"
        >
          <span class="h-2.5 w-2.5 rounded-full bg-ae-rule-strong" />
          <span class="h-2.5 w-2.5 rounded-full bg-ae-rule-strong" />
          <span class="h-2.5 w-2.5 rounded-full bg-ae-rule-strong" />
        </div>
        {/*
          The lightbox source is the same file, unlike `ScreenshotFigure` which
          renders a larger variant for it. There is nothing to render: the whole
          reason this component exists is that sharp flattens an animated GIF to
          its first frame, so any "larger" version would be a still. What the
          lightbox gives an animation is the viewport, not more pixels.
        */}
        <a
          class="ae-zoom relative"
          href={src}
          data-lightbox-src={src}
          data-lightbox-alt={alt}
          data-lightbox-caption={caption ?? alt}
          aria-label={`View larger: ${alt}`}
        >
          <img
            src={src}
            alt={alt}
            width={width}
            height={height}
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
          <ZoomBadge />
        </a>
      </div>
      {hasCaption && (
        <figcaption class="mt-3 text-sm leading-relaxed text-ae-muted">
          {caption}
          <slot />
        </figcaption>
      )}
    </figure>
  ) : fallback ? (
    <p class="rounded-ae border border-dashed border-ae-rule px-4 py-3 text-sm text-ae-muted">
      {caption ?? alt}
    </p>
  ) : null
}

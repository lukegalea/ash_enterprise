---
/**
 * The fold: the framework pitch on the left, and on the right a real resource
 * from the reference application, cut from source at build time
 * (`platform-resource` in `src/data/snippets.json`).
 *
 * Every count comes from `lib/facts`; the code comes from `snippet()`.
 */
import SnippetExhibit from './SnippetExhibit.astro';
import { withBase } from '../../lib/roadmap';
import { facts, numberWord } from '../../lib/facts';
import { pageHref } from './ledger';

const GITHUB = 'https://github.com/lukegalea/ash_enterprise';
const runIt = pageHref('/run-it/', '/docs/');
---

<section id="the-fold" aria-labelledby="the-fold-heading" class="border-b border-ae-rule">
  <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div class="flex flex-col justify-center px-[var(--ae-gutter)] py-16 lg:py-24 lg:pl-14 lg:pr-16">
      <p class="ae-eyebrow">Ash packages and a reference application</p>

      <h1 id="the-fold-heading" class="ae-h1 mt-6">
        Declare the resource.{' '}
        <em class="text-ae-workshop">Audit, tenancy and authorization come with it.</em>
      </h1>

      <p class="ae-lead mt-7">
        Ash Enterprise is a set of first-party packages for Ash and an application built on
        them. A resource that uses the platform base inherits a hash-chained audit trail,
        user-or-team ownership, tenant scoping, soft delete, lineage and a policy set that is a
        union of grants. The packages add BPMN processes, DMN decisions, compliance rules and
        governed agent actions over the same resources.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a class="ae-btn-primary" href={withBase('/platform/')}>
          See the platform <span aria-hidden="true">→</span>
        </a>
        <a class="ae-btn" href={runIt}>Run it locally</a>
        <a class="ae-link text-sm" href={GITHUB} target="_blank" rel="noopener noreferrer">
          Source on GitHub
        </a>
      </div>

      <ul
        class="mt-12 flex flex-wrap gap-x-6 gap-y-2 border-t border-ae-rule pt-5 font-mono text-[12px] tracking-[0.04em] text-ae-blueprint"
        aria-label="At a glance"
      >
        <li>{facts.resources.declaredOnBase} resources declare the platform base</li>
        <li>{numberWord(facts.packages.firstParty)} first-party packages</li>
        <li>MIT licence</li>
      </ul>
    </div>

    <div
      class="flex min-w-0 flex-col justify-center border-t border-ae-rule bg-ae-paper-2 px-[var(--ae-gutter)] py-16 lg:border-t-0 lg:border-l lg:px-14 lg:py-24"
    >
      <p class="ae-eyebrow mb-5">A resource from the reference application</p>
      <SnippetExhibit name="platform-resource" label="Exhibit 1" />
    </div>
  </div>
</section>

---
/**
 * Fig. 1 — the stack read as an elevation, generated from `docs/packages.json`.
 *
 * Stratum 05 is the platform base and every first-party package a release
 * carries, each linked to the commit mix.lock pins. Stratum 04 is what those
 * packages declare that is not ours and not Ash itself (`builds_on`), with the
 * forks the build carries linked to the fork. Nothing in either list is typed
 * here, so adding a package or a dependency changes the figure on the next
 * build. Strata 01–03 are the platform underneath.
 *
 * Read top-down 05 → 01; the reveal builds bottom-up when motion is allowed,
 * and the static render is always the final state.
 */
import { packages, forks, pinnedHref, facts, numberWord } from '../../lib/facts';
import { repoHref } from '../../lib/roadmap';

interface Chip {
  label: string;
  href?: string;
  note?: string;
}

const runtime = packages.filter((p) => p.only === null);
const firstPartyNames = new Set(packages.map((p) => p.name));
const forkByName = new Map(forks.map((f) => [f.name, f]));

const baseChip: Chip = {
  label: 'AshEnterprise.Platform.Resource',
  href: repoHref('lib/ash_enterprise/platform/resource.ex'),
};

const packageChips: Chip[] = runtime.map((p) => ({
  label: p.name,
  href: pinnedHref(p),
  note: p.declared === 'transitive' ? 'through another package' : undefined,
}));

const upstreamChips: Chip[] = [
  ...new Set(runtime.flatMap((p) => p.builds_on)),
]
  .filter((name) => name !== 'ash' && !firstPartyNames.has(name))
  .sort()
  .map((name) => {
    const fork = forkByName.get(name);
    return fork ? { label: name, href: fork.fork, note: 'fork' } : { label: name };
  });

interface Stratum {
  folio: string;
  title: string;
  annotation: string;
  bandClass: string;
  headingClass: string;
  chips?: 'first-party' | 'upstream';
}

const strata: Stratum[] = [
  {
    folio: '05',
    title: 'Ash Enterprise',
    annotation:
      'The platform base every resource uses, and the packages for what Ash leaves to an application: audit chains, processes, decisions, rules, compliance, master data and governed agents.',
    bandClass: 'border border-ae-workshop bg-ae-paper-2',
    headingClass: 'text-ae-workshop',
    chips: 'first-party',
  },
  {
    folio: '04',
    title: 'What those packages build on',
    annotation:
      'The Ash extensions and libraries the first-party packages declare, read from their own mix files.',
    bandClass: 'border border-ae-rule bg-ae-paper',
    headingClass: 'text-ae-ink',
    chips: 'upstream',
  },
  {
    folio: '03',
    title: 'Ash: resources, actions, policies',
    annotation: 'The declarative model every stratum above reads.',
    bandClass: 'border border-ae-rule bg-ae-paper-2',
    headingClass: 'text-ae-ink',
  },
  {
    folio: '02',
    title: 'Phoenix and LiveView · Elixir and OTP',
    annotation: 'The web layer and the runtime libraries.',
    bandClass: 'border border-ae-rule bg-ae-paper-3',
    headingClass: 'text-ae-ink',
  },
  {
    folio: '01',
    title: 'The BEAM',
    annotation: 'The Erlang virtual machine.',
    bandClass: 'border border-ae-rule bg-ae-paper-4',
    headingClass: 'text-ae-ink',
  },
];

const chipBase =
  'inline-flex items-center gap-1.5 px-2.5 py-[5px] font-mono text-[12.5px] leading-tight';
const tooling = packages.filter((p) => p.only !== null);
---

<figure id="ae-fig-stack">
  <div class="flex flex-col">
    {
      strata.map((s, i) => (
        <div
          class:list={[
            'ae-stratum grid grid-cols-1 lg:grid-cols-[72px_minmax(0,1fr)_280px] lg:items-stretch lg:gap-8',
            i > 0 && 'mt-3',
          ]}
        >
          <p class="font-mono text-[12px] text-ae-copper lg:pt-5">
            <span class="lg:hidden">stratum </span>
            {s.folio}
          </p>

          <div class:list={['min-w-0 py-4', s.bandClass]}>
            <h3
              class:list={[
                'px-5 font-mono text-[12px] font-medium uppercase tracking-[0.14em]',
                s.headingClass,
              ]}
            >
              {s.title}
            </h3>

            {s.chips === 'first-party' && (
              <ul class="flex flex-wrap gap-2 px-5 pt-3" aria-label="First-party packages">
                <li>
                  <a
                    class:list={[chipBase, 'bg-ae-workshop text-ae-on-accent hover:opacity-90']}
                    href={baseChip.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {baseChip.label}
                  </a>
                </li>
                {packageChips.map((chip) => (
                  <li>
                    <a
                      class:list={[
                        chipBase,
                        'border border-ae-workshop text-ae-ink transition-colors duration-150 hover:bg-ae-paper',
                      ]}
                      href={chip.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {chip.label}
                      {chip.note && <span class="text-ae-muted">({chip.note})</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {s.chips === 'upstream' && (
              <ul class="flex flex-wrap gap-2 px-5 pt-3" aria-label="Packages they build on">
                {upstreamChips.map((chip) => (
                  <li>
                    {chip.href ? (
                      <a
                        class:list={[
                          chipBase,
                          'border border-ae-rule-strong bg-ae-paper-2 text-ae-ink transition-colors duration-150 hover:border-ae-workshop',
                        ]}
                        href={chip.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {chip.label}
                        <span class="text-ae-muted">({chip.note})</span>
                      </a>
                    ) : (
                      <span class:list={[chipBase, 'border border-ae-rule bg-ae-paper-2 text-ae-ink']}>
                        {chip.label}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>

          <p class="mt-3 text-[14px] leading-[1.55] text-ae-muted lg:mt-0 lg:border-l lg:border-ae-rule lg:pt-5 lg:pl-6">
            {s.annotation}
          </p>
        </div>
      ))
    }
  </div>

  <figcaption class="mt-6 max-w-[820px] text-[14px] leading-[1.55] text-ae-muted">
    Fig. 1 — Generated from <code class="ae-code">docs/packages.json</code> at build time: the{' '}
    {numberWord(facts.packages.runtime)} first-party packages a release carries, each linked to the
    commit the lock file pins, and what they declare. {
      facts.packages.tooling > 0 && (
        <>Developer tooling is not in a release and is not drawn: {tooling.map((p) => p.name).join(', ')}.</>
      )
    } Every first-party package is distributed through git; none is published to Hex. {
      facts.packages.forks > 0 && <>A fork is marked where the build carries one.</>
    }
  </figcaption>
</figure>

<style>
  #ae-fig-stack[data-animate] .ae-stratum {
    opacity: 0;
    transform: translateY(8px);
  }

  .ae-stratum {
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  #ae-fig-stack[data-animate] .ae-stratum.is-revealed {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ae-stratum {
      transition: none;
    }
  }
</style>

<script>
  const fig = document.getElementById('ae-fig-stack');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fig && !reduced && 'IntersectionObserver' in window) {
    const rows = Array.from(fig.querySelectorAll<HTMLElement>('.ae-stratum'));
    fig.dataset.animate = '';

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        io.disconnect();
        rows
          .slice()
          .reverse()
          .forEach((row, i) => {
            window.setTimeout(() => row.classList.add('is-revealed'), i * 120);
          });
      },
      { threshold: 0.15 },
    );

    io.observe(fig);
  }
</script>

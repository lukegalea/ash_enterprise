---
/**
 * Per-section counts, as a set of bars.
 *
 * The aggregate number is honest and incomplete: one ratio across fifty-one
 * questions reports the project as uniformly half-finished, when in fact
 * evidence is nearly done and assurance has barely started — and which of those
 * a reader cares about depends entirely on why they came.
 *
 * Everything is computed from `docs/roadmap.json`, so a question moving section
 * or status changes this and nothing else has to be edited.
 */
import { deliveryStatuses, statusColor, statusLabel } from './status';
import { countsBySection, withBase } from '../lib/roadmap';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const rows = countsBySection();

---

<div class={className}>
  <ul class="space-y-5">
    {
      rows.map(({ section, counts }) => (
        <li>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-sm font-semibold text-balance">{section.title}</h3>
            <p class="text-xs text-ae-muted tabular-nums">
              <span class="font-semibold text-ae-ink">{counts.shipped}</span> of {counts.total} shipped
            </p>
          </div>

          <div
            class="mt-2 flex h-2.5 w-full overflow-hidden bg-ae-rule"
            role="img"
            aria-label={deliveryStatuses
              .map((s) => `${counts[s]} ${statusLabel[s].toLowerCase()}`)
              .join(', ')}
          >
            {deliveryStatuses.map((status) =>
              counts[status] > 0 ? (
                <span
                  class="ae-bar h-full"
                  style={`width: ${(counts[status] / counts.total) * 100}%; background-color: ${statusColor[status]}`}
                />
              ) : null,
            )}
          </div>
        </li>
      ))
    }
  </ul>

  <p class="mt-6 text-xs leading-relaxed text-ae-muted">
    Read the rows, not the total. The two sections a reader usually arrives for — who may do what,
    and what happened — are the two furthest along; the one that scores worst is the one about
    proving it to somebody else, which is mostly process rather than code and says so.{' '}
    <a class="ae-link" href={withBase('/docs/questions/')}>
      Every row, with its proof
    </a>
    .
  </p>
</div>

<style>
  /* Segments are separated by a paper hairline, so adjacent statuses never
   * merge into one block of colour, and `open` reads as a gap, not a fill. */
  .ae-bar + .ae-bar {
    border-left: 2px solid var(--ae-paper);
  }
</style>

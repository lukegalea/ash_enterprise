{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ash-hq.org/schemas/judgment-record/v0.json",
  "title": "System One judgment record v0 — observation",
  "description": "The frozen v0 observation record of RFC S1-24 (docs/rfc/judgment-record-v0.md, status 'ACCEPTED — v0 FROZEN'). Top level: the observation of §5 — the provenance envelope core plus the judgment extension. $defs carry the question registry identity (§3.1), the question_hash input object (§3.2), the wire question object (§3.3) and the admission result vocabulary (§7.2, Q11).",
  "$comment": "additionalProperties stays open everywhere except $defs/question_hash_input, per §11: additive within a major version — consumers ignore unknown fields. Any v0.x field this schema does not know yet must therefore still validate.",
  "type": "object",
  "required": [
    "id",
    "record_version",
    "envelope",
    "judgment",
    "record_hash"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "$ref": "#/$defs/uuid",
      "description": "§4.1: UUID primary key, UUIDv7 recommended. Generated by the caller before the instrument is called (§6)."
    },
    "record_version": {
      "const": "0",
      "description": "§11: major version only."
    },
    "envelope": {
      "type": "object",
      "description": "§5.2: the envelope core (provenance-envelope.md §2.1), unchanged, plus the actor-and-grant fields this RFC adds.",
      "required": [
        "semantic_id",
        "definition_version",
        "tenant_id",
        "actor_id",
        "system_actor",
        "impersonator_id",
        "input_digest",
        "output_digest",
        "redaction_digest",
        "dropped_fields",
        "matched_rule_ids",
        "policy_decision_ids",
        "evidence_ids",
        "correlation_id",
        "process_instance_id",
        "trace_id",
        "span_id",
        "depth",
        "automation_principal",
        "grant_ref"
      ],
      "additionalProperties": true,
      "properties": {
        "semantic_id": {
          "type": "string",
          "pattern": "^ash:v0:[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*#(actions|code_interface|policies)/[A-Za-z0-9_/]+$",
          "description": "§5.2: the evaluate (or prompt) action's ash: id in the semantic-manifest grammar (envelope §2.2). Names what ran; question_id names what was asked."
        },
        "definition_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "§5.2 / envelope §2.3: the action's manifest content hash (sha256:...), or the DMN/BPMN integer-as-string / t3<-p5 fork form, or null. Never a guess."
        },
        "tenant_id": {
          "$ref": "#/$defs/uuid_or_null"
        },
        "actor_id": {
          "$ref": "#/$defs/uuid_or_null"
        },
        "system_actor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Set exactly when actor_id is nil (envelope §2.1)."
        },
        "impersonator_id": {
          "$ref": "#/$defs/uuid_or_null"
        },
        "input_digest": {
          "$ref": "#/$defs/digest",
          "description": "§5.2: equal to judgment.input.input_hash, kept under both names so envelope consumers work unchanged. (Schema cannot assert the equality; the golden fixtures pin it.)"
        },
        "output_digest": {
          "$ref": "#/$defs/digest_or_null",
          "description": "§5.2: digest of the canonical answer block minus log-probs and raw reply; null when nothing was answered (§4.2 rule 4: the digest of nothing is null)."
        },
        "redaction_digest": {
          "$ref": "#/$defs/digest_or_null"
        },
        "dropped_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched_rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy_decision_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Envelope §2.5: populated for the evaluate action's authorization; symbol-id:outcome form or the policy:v0:unavailable sentinel."
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "description": "§5.2: candidate atoms are NOT here (they live in judgment.input). Names durable artefacts consulted, with the reference kinds of envelope §2.6 plus the §4.1 kinds."
        },
        "correlation_id": {
          "$ref": "#/$defs/uuid"
        },
        "process_instance_id": {
          "$ref": "#/$defs/uuid_or_null"
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{32}$",
          "description": "W3C trace id, 32 lower hex (envelope §2.1)."
        },
        "span_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{16}$",
          "description": "W3C span id, 16 lower hex."
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "automation_principal": {
          "type": [
            "string",
            "null"
          ],
          "description": "§5.2 (ADR 0043): set when the call was made by an automation principal, e.g. evidence_admitter. Mutually exclusive with system_actor for the same row."
        },
        "grant_ref": {
          "$ref": "#/$defs/grant_ref",
          "description": "§5.2: the grant row the principal's ActorContext held for this call; null for a human actor."
        }
      }
    },
    "judgment": {
      "type": "object",
      "description": "§5.1: the judgment extension block.",
      "required": [
        "question",
        "instrument",
        "input",
        "answer",
        "call"
      ],
      "additionalProperties": true,
      "properties": {
        "question": {
          "type": "object",
          "required": [
            "question_id",
            "question_hash",
            "question_version",
            "family",
            "wire_question_hash",
            "question_set_hash"
          ],
          "additionalProperties": true,
          "properties": {
            "question_id": {
              "$ref": "#/$defs/question_id"
            },
            "question_hash": {
              "$ref": "#/$defs/digest",
              "description": "§3.2: digest of the canonical JSON of $defs/question_hash_input. Identifies the declaration."
            },
            "question_version": {
              "type": "integer",
              "description": "§3.4: the declared version; monotonic per question_id."
            },
            "family": {
              "type": "string",
              "minLength": 1,
              "description": "Calibration grouping (ADR 0041); outside the hash (§3.2, Q3)."
            },
            "wire_question_hash": {
              "$ref": "#/$defs/digest_or_null",
              "description": "§3.3: digest of the exact question object sent. Identifies the call; the cache key uses it (§4.4). Required non-null at the decision rung (§5.2)."
            },
            "question_set_hash": {
              "$ref": "#/$defs/digest",
              "description": "§5.2: digest of the sorted list of question_hash values asked in the same request (law 6)."
            }
          }
        },
        "instrument": {
          "type": "object",
          "required": [
            "profile",
            "rung",
            "provider",
            "model_spec_requested",
            "model_reported",
            "model_digest",
            "runtime",
            "runtime_version",
            "accelerator",
            "zone_id"
          ],
          "additionalProperties": true,
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1,
              "description": "§5.3: the named profile the host resolved (ADR 0039). No endpoints here (§9)."
            },
            "rung": {
              "enum": [
                "decision",
                "generative",
                "emulated"
              ],
              "description": "§5.3. emulated is never pooled with decision (ADR 0042). Closed enum (§11)."
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "description": "The req_llm provider id, e.g. typesafe."
            },
            "model_spec_requested": {
              "type": "string",
              "minLength": 1,
              "description": "§5.3: the model name as requested, without base_url or keys (§9). An alias is allowed only where model_digest resolves it (§5.7 rule 5)."
            },
            "model_reported": {
              "type": [
                "string",
                "null"
              ],
              "description": "§5.3: AshAi.Actions.Result.model — what the runtime said answered."
            },
            "model_digest": {
              "type": [
                "string",
                "null"
              ],
              "$comment": "§5.3: the content digest of the model weights as the runtime reports it (Q7: fetched over HTTP at call time). Format is the runtime's own, so no pattern is imposed here — digests copied from elsewhere keep their source format (§4.2). Required non-null for pin:required questions before banding into admit (§5.7 rule 3) — that rule is banding-side and cannot be expressed here because pin lives on the question record.",
              "minLength": 1
            },
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "runtime_version": {
              "type": "string",
              "minLength": 1,
              "description": "§5.3: pinned version as reported by the runtime; part of the cache key (§4.4, Q6)."
            },
            "accelerator": {
              "enum": [
                "gpu",
                "cpu",
                "unknown"
              ],
              "description": "§5.3: what actually executed. Mismatch is flagged, and refused for admit bands (Q8)."
            },
            "wire_spec_version": {
              "type": [
                "string",
                "null"
              ],
              "description": "§5.3: the wire compatibility version the runtime declares (ADR 0042 contract tests)."
            },
            "wire_schema_hash": {
              "$ref": "#/$defs/digest_or_null",
              "description": "§5.3 (ADR 0046 point 6): the exact JSON Schema sent, after per-call narrowing. Required non-null for the generative rung; null for decision."
            },
            "sampling": {
              "type": [
                "object",
                "null"
              ],
              "description": "§5.3: temperature, seed, top-p and similar, as sent. Required non-null for the generative rung; null for the decision rung."
            },
            "zone_id": {
              "type": "string",
              "minLength": 1,
              "description": "§5.3: the zone the instrument runs in. Must equal judgment.input.zone_id or the call is a disclosure (ADR 0042). (Schema cannot assert the equality; the golden fixtures pin it.)"
            }
          }
        },
        "input": {
          "type": "object",
          "required": [
            "input_hash",
            "state_ref",
            "subject_type",
            "subject_id",
            "data_class",
            "residency_restriction",
            "zone_id",
            "jurisdiction"
          ],
          "additionalProperties": true,
          "properties": {
            "input_hash": {
              "$ref": "#/$defs/digest",
              "description": "§5.4 / §4.2: digest of the exact state body sent on the wire (the normalised form, envelope §2.4 rule 1)."
            },
            "state_ref": {
              "$ref": "#/$defs/state_ref"
            },
            "subject_type": {
              "type": "string",
              "minLength": 1,
              "description": "§5.4: denormalised from state_ref for queries."
            },
            "subject_id": {
              "type": "string",
              "minLength": 1
            },
            "rule_ref": {
              "type": [
                "object",
                "null"
              ],
              "description": "§5.4: for evidence work — {bundle_hash, rule_id, predicate_id}.",
              "required": [
                "bundle_hash",
                "rule_id",
                "predicate_id"
              ],
              "properties": {
                "bundle_hash": {
                  "$ref": "#/$defs/digest"
                },
                "rule_id": {
                  "type": "string"
                },
                "predicate_id": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "document_version_hash": {
              "$ref": "#/$defs/digest_or_null",
              "description": "§5.4: required (non-null) when the state came from a document, which also requires parser_version and atomiser_version (law 6)."
            },
            "candidate_atom_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "§5.4 (ADR 0044 evidence contract): atoms considered."
            },
            "parser_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "atomiser_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "retrieval": {
              "type": [
                "object",
                "null"
              ],
              "description": "§5.4: {embedder_profile, embedder_digest, index_version} when retrieval chose the atoms. Provenance only; not in the cache key (Q14).",
              "required": [
                "embedder_profile",
                "embedder_digest",
                "index_version"
              ],
              "properties": {
                "embedder_profile": {
                  "type": "string"
                },
                "embedder_digest": {
                  "type": "string",
                  "$comment": "Runtime-reported format; no pattern imposed (§4.2)."
                },
                "index_version": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "data_class": {
              "enum": [
                "public",
                "synthetic",
                "internal",
                "customer_confidential"
              ],
              "description": "§5.4 (ADR 0042): at or below both the zone ceiling and the question's data_class_ceiling. Closed enum (§11)."
            },
            "residency_restriction": {
              "type": [
                "string",
                "null"
              ],
              "description": "§5.4: the source data's residency tag; null for none. A row with an unknown tag cannot exist."
            },
            "zone_id": {
              "type": "string",
              "minLength": 1,
              "description": "§5.4: the data's zone. No observation without a zone (§5.7 rule 2)."
            },
            "jurisdiction": {
              "type": "string",
              "minLength": 1,
              "description": "§5.4: denormalised from the zone record at write time (law 10). Example placeholder EX-1 (Q18)."
            },
            "state": {
              "type": [
                "object",
                "null"
              ],
              "description": "§5.4 / §10: PAYLOAD CLASS. The state itself. null after erasure or for digest-only families; erasure leaves record_hash valid (§4.5)."
            }
          }
        },
        "answer": {
          "type": "object",
          "required": [
            "outcome",
            "kind"
          ],
          "additionalProperties": true,
          "properties": {
            "outcome": {
              "enum": [
                "answered",
                "cast_failed",
                "instrument_error",
                "timeout",
                "refused"
              ],
              "description": "§5.5: a failure is still an observation (ADR 0046 point 3). Closed enum (§11)."
            },
            "kind": {
              "enum": [
                "noul",
                "choice",
                "score",
                "evidence",
                "extraction"
              ],
              "description": "§5.5. Closed enum (§11)."
            },
            "value": {
              "$comment": "§5.5: required when outcome is answered; null otherwise (conditionals at the root). Noul: always null (Q9). Choice/evidence: the option string. Score: the probability-weighted position as a decimal string. Extraction: the cast value.",
              "description": "§5.5: the collapsed value, per kind."
            },
            "level": {
              "type": [
                "string",
                "null"
              ],
              "description": "§5.5: Score only."
            },
            "distribution": {
              "type": [
                "object",
                "null"
              ],
              "description": "§5.5: option (or level index) → decimal string. For Noul {\"true\": p, \"false\": 1−p} so every decision answer has one shape. Required non-null at the decision rung when answered.",
              "additionalProperties": {
                "$ref": "#/$defs/decimal_string"
              }
            },
            "confidence": {
              "$ref": "#/$defs/decimal_or_null",
              "description": "§5.5: as returned. Noul has none; extraction never has one (ADR 0046 point 5)."
            },
            "status": {
              "enum": [
                "found",
                "not_found",
                "ambiguous",
                null
              ],
              "description": "§5.5 (ADR 0044 extract → verify): extraction only."
            },
            "source_ids": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              },
              "description": "§5.5: atom ids only (e.g. atom:12), constrained on the wire to the packet's atom ids for extraction."
            },
            "selected_atom_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "§5.5 (ADR 0044): evidence, when available; Q15 asks where these belong."
            },
            "limiting_atom_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_dimensions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "raw": {
              "$comment": "§5.5 / §10: PAYLOAD CLASS — the runtime's raw answer for this question id, or the generative raw reply before the Ash cast. Any JSON, nullable; excluded from record_hash (§4.5).",
              "description": "§5.5: payload class."
            },
            "logprobs": {
              "type": [
                "object",
                "null"
              ],
              "description": "§5.5 / §10: PAYLOAD CLASS. {source, format, top_k, tokens: [...]}. Required non-null for the emulated rung, whose distribution is computed from them.",
              "additionalProperties": true
            },
            "error": {
              "type": [
                "object",
                "null"
              ],
              "description": "§5.5: required when the outcome is a failure. The message itself is payload class because runtime errors can echo input text — only its digest is kept.",
              "required": [
                "class",
                "message_digest"
              ],
              "properties": {
                "class": {
                  "type": "string"
                },
                "message_digest": {
                  "$ref": "#/$defs/digest"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "call": {
          "type": "object",
          "required": [
            "mode",
            "request_id",
            "cache_key",
            "requested_at",
            "answered_at",
            "recorded_at",
            "latency_us"
          ],
          "additionalProperties": true,
          "properties": {
            "mode": {
              "enum": [
                "live",
                "shadow",
                "calibration",
                "eval"
              ],
              "description": "§5.6 / §6.3: replay never writes and a cache hit never writes, so neither appears. Closed enum (§11)."
            },
            "request_id": {
              "$ref": "#/$defs/uuid",
              "description": "§5.6: shared by every observation from one runtime request."
            },
            "cache_key": {
              "$ref": "#/$defs/digest",
              "description": "§4.4: digest over {input_hash, model_digest, runtime_version, wire_question_hash, zone_id}. Tenant is not in the key (§4.4)."
            },
            "shadow_of": {
              "$ref": "#/$defs/uuid_or_null",
              "description": "§5.6: the incumbent observation this one shadows; required non-null exactly when mode is shadow."
            },
            "run_id": {
              "$ref": "#/$defs/uuid_or_null",
              "description": "§5.6: the calibration or evaluation run; required non-null for calibration/eval."
            },
            "requested_at": {
              "$ref": "#/$defs/timestamp",
              "description": "§5.6: when the call was sent. ISO-8601 UTC, microseconds."
            },
            "answered_at": {
              "$ref": "#/$defs/timestamp_or_null",
              "description": "§5.6: when the answer arrived; null on timeout."
            },
            "recorded_at": {
              "$ref": "#/$defs/timestamp",
              "description": "§5.6: row insert time, set by the database, not the caller (§6.1)."
            },
            "latency_us": {
              "type": [
                "integer",
                "null"
              ],
              "description": "§5.6: wall time of the request; shared across a request_id."
            },
            "usage": {
              "type": [
                "object",
                "null"
              ],
              "description": "§5.6: as normalised by ReqLLM; scope is the request, not the question.",
              "additionalProperties": true
            }
          }
        },
        "lineage": {
          "type": "object",
          "description": "§5.1: shadow_of and supersedes_nothing — observations never supersede.",
          "additionalProperties": true,
          "properties": {
            "shadow_of": {
              "$ref": "#/$defs/uuid_or_null"
            }
          }
        }
      }
    },
    "record_hash": {
      "$ref": "#/$defs/digest",
      "description": "§4.5: digest of the record's own canonical JSON minus record_hash and minus every payload-class field (§10) — a record whose payload was erased still verifies."
    }
  },
  "allOf": [
    {
      "if": {
        "$ref": "#/$defs/cond_answered"
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "answer": {
                "required": [
                  "value"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "judgment": {
            "properties": {
              "answer": {
                "required": [
                  "error"
                ],
                "properties": {
                  "value": {
                    "const": null
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.5 / Q9: a noul has no collapsed value and no confidence.",
      "if": {
        "$ref": "#/$defs/cond_kind_noul"
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "answer": {
                "properties": {
                  "value": {
                    "const": null
                  },
                  "confidence": {
                    "const": null
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.5: Choice/evidence answer with the option string.",
      "if": {
        "allOf": [
          {
            "$ref": "#/$defs/cond_answered"
          },
          {
            "$ref": "#/$defs/cond_kind_choice_or_evidence"
          }
        ]
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "answer": {
                "properties": {
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.5: Score answers with a decimal string; level present.",
      "if": {
        "allOf": [
          {
            "$ref": "#/$defs/cond_answered"
          },
          {
            "$ref": "#/$defs/cond_kind_score"
          }
        ]
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "answer": {
                "properties": {
                  "value": {
                    "$ref": "#/$defs/decimal_string"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.5: level is Score-only, present whenever kind is score.",
      "if": {
        "$ref": "#/$defs/cond_kind_score"
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "answer": {
                "required": [
                  "level"
                ]
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.5 (ADR 0046 point 5): extraction never has a confidence, and carries status.",
      "if": {
        "$ref": "#/$defs/cond_kind_extraction"
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "answer": {
                "required": [
                  "status"
                ],
                "properties": {
                  "confidence": {
                    "const": null
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.5: status is extraction-only.",
      "if": {
        "not": {
          "$ref": "#/$defs/cond_kind_extraction"
        }
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "answer": {
                "properties": {
                  "status": {
                    "const": null
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.6: answered_at is null on timeout.",
      "if": {
        "$ref": "#/$defs/cond_outcome_timeout"
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "call": {
                "properties": {
                  "answered_at": {
                    "const": null
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.3: the generative rung sends an exact JSON Schema (ADR 0046) and its sampling as sent.",
      "if": {
        "$ref": "#/$defs/cond_rung_generative"
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "instrument": {
                "required": [
                  "wire_schema_hash",
                  "sampling"
                ],
                "properties": {
                  "wire_schema_hash": {
                    "$ref": "#/$defs/digest"
                  },
                  "sampling": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.3: sampling is null for the decision rung; no wire schema is sent.",
      "if": {
        "$ref": "#/$defs/cond_rung_decision"
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "instrument": {
                "properties": {
                  "wire_schema_hash": {
                    "const": null
                  },
                  "sampling": {
                    "const": null
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.5: an answered decision-rung answer always has a distribution (§3.3: Noul's is derived from its single probability).",
      "if": {
        "allOf": [
          {
            "$ref": "#/$defs/cond_answered"
          },
          {
            "$ref": "#/$defs/cond_rung_decision"
          }
        ]
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "answer": {
                "required": [
                  "distribution"
                ],
                "properties": {
                  "distribution": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.5: logprobs are required for the emulated rung, since its distribution is computed from them.",
      "if": {
        "$ref": "#/$defs/cond_rung_emulated"
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "answer": {
                "required": [
                  "logprobs"
                ],
                "properties": {
                  "logprobs": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.6: shadow_of is required exactly when mode is shadow.",
      "if": {
        "$ref": "#/$defs/cond_mode_shadow"
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "call": {
                "required": [
                  "shadow_of"
                ],
                "properties": {
                  "shadow_of": {
                    "$ref": "#/$defs/uuid"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.6: run_id is required for calibration and eval.",
      "if": {
        "$ref": "#/$defs/cond_mode_run"
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "call": {
                "required": [
                  "run_id"
                ],
                "properties": {
                  "run_id": {
                    "$ref": "#/$defs/uuid"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.2: automation_principal is mutually exclusive with system_actor for the same row.",
      "if": {
        "properties": {
          "envelope": {
            "required": [
              "automation_principal"
            ],
            "properties": {
              "automation_principal": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "envelope"
        ]
      },
      "then": {
        "properties": {
          "envelope": {
            "properties": {
              "system_actor": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.2: the converse exclusion — a system actor row carries no automation principal.",
      "if": {
        "properties": {
          "envelope": {
            "required": [
              "system_actor"
            ],
            "properties": {
              "system_actor": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "envelope"
        ]
      },
      "then": {
        "properties": {
          "envelope": {
            "properties": {
              "automation_principal": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "$comment": "§5.4: when the state came from a document, law 6 requires the parser and atomiser versions.",
      "if": {
        "properties": {
          "judgment": {
            "required": [
              "input"
            ],
            "properties": {
              "input": {
                "required": [
                  "document_version_hash"
                ],
                "properties": {
                  "document_version_hash": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "required": [
          "judgment"
        ]
      },
      "then": {
        "properties": {
          "judgment": {
            "properties": {
              "input": {
                "required": [
                  "parser_version",
                  "atomiser_version"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuid_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "$comment": "§4.2: 'sha256:' <> lower hex, FULL length (64 hex characters / 256 bits) for every digest this RFC defines — Q4's proposed position. Not the semantic-manifest's 128-bit truncation."
    },
    "digest_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decimal_string": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "$comment": "§4.3: probabilities, confidences and Score values are decimal strings — the shortest decimal that round-trips the returned double (Q5 keeps the precision rule open). Plain positional form; no floats in canonical JSON."
    },
    "decimal_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "description": "§5.6: ISO-8601 UTC, microseconds."
    },
    "timestamp_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^judgment:v0:[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*#judgments/[A-Za-z][A-Za-z0-9_]*$",
      "description": "§3.1: judgment:v0:<Module>#judgments/<name> — <Module> a dotted module string without the Elixir. prefix, <name> the declared question name. Structural, not content-hashed; the content lives in question_hash. Consumers that do not recognise the judgment: scheme treat the id as opaque (semantic-manifest §6.2)."
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^(observation|banding|admission|verdict|calibration|question|evaluation|audit|compliance|process_event|signal):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "§4.1: the envelope's <kind>:<uuid> form (envelope §2.6) with the new kinds observation:, banding:, admission:, verdict:, calibration: and question:."
    },
    "grant_ref": {
      "type": [
        "object",
        "null"
      ],
      "description": "§5.2 / §7.2: {grant_id, role, privilege, family, risk_tier} from the principal's ActorContext; the admission record's form adds tenant_id (§7.2).",
      "required": [
        "grant_id",
        "role",
        "privilege",
        "family",
        "risk_tier"
      ],
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/uuid"
        },
        "role": {
          "type": "string"
        },
        "privilege": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "risk_tier": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "state_ref": {
      "type": "object",
      "description": "§5.4: what the state was drawn from, as references.",
      "required": [
        "subject"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "document_version_hash": {
          "$ref": "#/$defs/digest_or_null"
        },
        "atom_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "question_hash_input": {
      "type": "object",
      "description": "§3.2: the EXACT object whose canonical JSON (§4.3) is digested into question_hash — ADR 0039 property 2's inputs plus the proposed state_contract (Q1). family is not in the hash (Q3); lineage is not in the hash (ADR 0039, ADR 0047). Closed here because any extra key would change the hash.",
      "required": [
        "answer_type",
        "criteria",
        "instructions",
        "options",
        "state_contract",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "answer_type": {
          "type": "string",
          "description": "The AshAi evaluate answer module, e.g. AshAi.Evaluate.Choice."
        },
        "criteria": {
          "type": "object",
          "description": "Per-option or true/false descriptions, as declared."
        },
        "instructions": {
          "$comment": "A string, or the declared JSON structure (§3.2). Any JSON.",
          "description": "As declared."
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "In declaration order: the Choice option list, the Score level list, or [true, false] for Noul (§3.2)."
        },
        "state_contract": {
          "$ref": "#/$defs/digest",
          "description": "§3.2: digest of the declared shape of the state projection's output (ADR 0046 §2 mapping). PROPOSED — open question Q1."
        },
        "version": {
          "type": "integer",
          "description": "The declared version; monotonic per question_id (§3.4)."
        }
      }
    },
    "wire_question": {
      "type": "object",
      "description": "§3.3: the exact question object sent for one question id, after Answer.to_question/3, before the provider's own normalisation — the input to wire_question_hash.",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": [
            "choice",
            "noul",
            "score"
          ],
          "description": "§3.3, e.g. {\"type\":\"choice\",\"instructions\":…,\"criteria\":…}."
        },
        "instructions": {
          "$comment": "§3.3: a matrix action may supply per-element instructions at runtime; the wire object is what was actually sent.",
          "description": "As sent."
        },
        "criteria": {
          "description": "As sent."
        }
      }
    },
    "admission_result": {
      "enum": [
        "admitted",
        "review",
        "omitted"
      ],
      "description": "§7.2: what an admission turns a banding into. 'omitted' — NOT 'unknown' — is the value for 'no fact written', settled by Luke on 2026-09-28 (Q11): unknown is an ash_rules outcome, and reusing the word across layers is the mixing ADR 0038 forbids. Closed enum (§11)."
    },
    "cond_answered": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "object",
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "answered"
                }
              }
            }
          }
        }
      }
    },
    "cond_outcome_timeout": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "object",
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "timeout"
                }
              }
            }
          }
        }
      }
    },
    "cond_kind_noul": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "noul"
                }
              }
            }
          }
        }
      }
    },
    "cond_kind_choice_or_evidence": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "choice",
                    "evidence"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "cond_kind_score": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "score"
                }
              }
            }
          }
        }
      }
    },
    "cond_kind_extraction": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "extraction"
                }
              }
            }
          }
        }
      }
    },
    "cond_rung_decision": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "instrument"
          ],
          "properties": {
            "instrument": {
              "type": "object",
              "required": [
                "rung"
              ],
              "properties": {
                "rung": {
                  "const": "decision"
                }
              }
            }
          }
        }
      }
    },
    "cond_rung_generative": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "instrument"
          ],
          "properties": {
            "instrument": {
              "type": "object",
              "required": [
                "rung"
              ],
              "properties": {
                "rung": {
                  "const": "generative"
                }
              }
            }
          }
        }
      }
    },
    "cond_rung_emulated": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "instrument"
          ],
          "properties": {
            "instrument": {
              "type": "object",
              "required": [
                "rung"
              ],
              "properties": {
                "rung": {
                  "const": "emulated"
                }
              }
            }
          }
        }
      }
    },
    "cond_mode_shadow": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "call"
          ],
          "properties": {
            "call": {
              "type": "object",
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "shadow"
                }
              }
            }
          }
        }
      }
    },
    "cond_mode_run": {
      "type": "object",
      "required": [
        "judgment"
      ],
      "properties": {
        "judgment": {
          "type": "object",
          "required": [
            "call"
          ],
          "properties": {
            "call": {
              "type": "object",
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "calibration",
                    "eval"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}

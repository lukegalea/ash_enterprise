      "code?": false,
      "down": "DO $repair$\nBEGIN\n  RAISE NOTICE 'system_one_facts: the temporal primary key belongs to the resource; nothing to undo';\nEND\n$repair$\n",
      "global?": false,
      "name": "system_one_facts_temporal_primary_key",
      "up": "DO $repair$\nDECLARE\n  existing text;\n  temporal boolean;\nBEGIN\n  SELECT pg_get_constraintdef(oid), conperiod INTO existing, temporal\n  FROM pg_constraint\n  WHERE conrelid = to_regclass('\"system_one_facts\"') AND contype = 'p';\n\n  IF existing IS NULL THEN\n    ALTER TABLE \"system_one_facts\" ADD PRIMARY KEY (id, valid_at WITHOUT OVERLAPS);\n  ELSIF NOT temporal THEN\n    RAISE EXCEPTION 'system_one_facts has a primary key that is not temporal: %', existing;\n  END IF;\nEND\n$repair$\n"
    }

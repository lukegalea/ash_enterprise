      ],
      "code?": false,
      "down": "DO $temporal$\nBEGIN\n  ALTER TABLE canonical_calendar_events DROP CONSTRAINT IF EXISTS canonical_calendar_events_unique_external_index;\n  ALTER TABLE canonical_calendar_events DROP CONSTRAINT IF EXISTS canonical_calendar_events_unique_provider_uid_index;\n  IF EXISTS (\n    SELECT 1 FROM pg_constraint\n    WHERE conrelid = to_regclass('canonical_calendar_events') AND contype = 'p' AND conperiod\n  ) THEN\n    DELETE FROM canonical_calendar_events older USING canonical_calendar_events newer\n      WHERE older.id = newer.id AND lower(older.valid_at) < lower(newer.valid_at);\n    ALTER TABLE canonical_calendar_events DROP CONSTRAINT canonical_calendar_events_pkey;\n    ALTER TABLE canonical_calendar_events ADD PRIMARY KEY (id);\n  END IF;\n  CREATE UNIQUE INDEX IF NOT EXISTS canonical_calendar_events_unique_external_index ON canonical_calendar_events (external_system, external_id);\n  CREATE UNIQUE INDEX IF NOT EXISTS canonical_calendar_events_unique_provider_uid_index ON canonical_calendar_events (external_system, external_uid);\nEND\n$temporal$\n",
      "global?": false,
      "name": "canonical_calendar_events_temporal",
      "up": "DO $temporal$\nBEGIN\n  IF NOT EXISTS (\n    SELECT 1 FROM pg_constraint\n    WHERE conrelid = to_regclass('canonical_calendar_events') AND contype = 'p' AND conperiod\n  ) THEN\n    UPDATE canonical_calendar_events SET valid_at = tstzrange(inserted_at AT TIME ZONE 'UTC', NULL);\n    ALTER TABLE canonical_calendar_events DROP CONSTRAINT IF EXISTS canonical_calendar_events_pkey;\n    ALTER TABLE canonical_calendar_events ADD PRIMARY KEY (id, valid_at WITHOUT OVERLAPS);\n  END IF;\n  IF NOT EXISTS (\n    SELECT 1 FROM pg_constraint\n    WHERE conrelid = to_regclass('canonical_calendar_events') AND conname = 'canonical_calendar_events_unique_external_index' AND contype = 'x'\n  ) THEN\n    DROP INDEX IF EXISTS canonical_calendar_events_unique_external_index;\n    ALTER TABLE canonical_calendar_events ADD CONSTRAINT canonical_calendar_events_unique_external_index\n      EXCLUDE USING gist (external_system WITH =, external_id WITH =, valid_at WITH &&);\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1 FROM pg_constraint\n    WHERE conrelid = to_regclass('canonical_calendar_events') AND conname = 'canonical_calendar_events_unique_provider_uid_index' AND contype = 'x'\n  ) THEN\n    DROP INDEX IF EXISTS canonical_calendar_events_unique_provider_uid_index;\n    ALTER TABLE canonical_calendar_events ADD CONSTRAINT canonical_calendar_events_unique_provider_uid_index\n      EXCLUDE USING gist (external_system WITH =, external_uid WITH =, valid_at WITH &&);\n  END IF;\n\nEND\n$temporal$\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DO $fkeys$\nBEGIN\n  ALTER TABLE canonical_calendar_events DROP CONSTRAINT IF EXISTS canonical_calendar_events_erasure_scope_id_fkey;\n  ALTER TABLE canonical_calendar_events DROP CONSTRAINT IF EXISTS canonical_calendar_events_organizer_id_fkey;\nEND\n$fkeys$\n",
      "global?": false,
      "name": "canonical_calendar_events_foreign_keys",
      "up": "DO $fkeys$\nBEGIN\n  IF NOT EXISTS (\n    SELECT 1 FROM pg_constraint\n    WHERE conrelid = to_regclass('canonical_calendar_events') AND conname = 'canonical_calendar_events_erasure_scope_id_fkey'\n  ) THEN\n    ALTER TABLE canonical_calendar_events ADD CONSTRAINT canonical_calendar_events_erasure_scope_id_fkey FOREIGN KEY (erasure_scope_id) REFERENCES erasure_scopes(id) ON DELETE RESTRICT;\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1 FROM pg_constraint\n    WHERE conrelid = to_regclass('canonical_calendar_events') AND conname = 'canonical_calendar_events_organizer_id_fkey'\n  ) THEN\n    ALTER TABLE canonical_calendar_events ADD CONSTRAINT canonical_calendar_events_organizer_id_fkey FOREIGN KEY (organizer_id) REFERENCES canonical_people(id);\n  END IF;\n\nEND\n$fkeys$\n"
    }

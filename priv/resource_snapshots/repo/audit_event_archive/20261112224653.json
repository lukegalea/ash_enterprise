  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION IF EXISTS ash_enterprise_audit_archive_guard();",
      "global?": false,
      "name": "audit_event_archive_guard_function",
      "up": "CREATE OR REPLACE FUNCTION ash_enterprise_audit_archive_guard() RETURNS trigger AS $fn$\nBEGIN\n  IF TG_OP = 'DELETE' AND OLD.occurred_at < now() - interval '400 days' THEN\n    RETURN OLD;\n  END IF;\n\n  RAISE EXCEPTION 'audit_event_archive keeps every event for 400 days; % is not permitted', TG_OP\n    USING ERRCODE = 'restrict_violation',\n          HINT = 'Archived events are never edited, and are purged only after 400 days.';\nEND;\n$fn$ LANGUAGE plpgsql;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS audit_event_archive_guard ON audit_event_archive;",
      "global?": false,
      "name": "audit_event_archive_guard_trigger",
      "up": "CREATE OR REPLACE TRIGGER audit_event_archive_guard\n  BEFORE UPDATE OR DELETE ON audit_event_archive\n  FOR EACH ROW EXECUTE FUNCTION ash_enterprise_audit_archive_guard();\n"
    }
  ],

  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION IF EXISTS ash_enterprise_evidence_archive_guard();",
      "global?": false,
      "name": "evidence_artifact_archive_guard_function",
      "up": "CREATE OR REPLACE FUNCTION ash_enterprise_evidence_archive_guard() RETURNS trigger AS $fn$\nBEGIN\n  IF TG_OP = 'DELETE'\n     AND greatest(OLD.collected_at, OLD.inserted_at) < now() - interval '400 days' THEN\n    RETURN OLD;\n  END IF;\n\n  RAISE EXCEPTION 'evidence_artifact_archive keeps every artifact for 400 days; % is not permitted', TG_OP\n    USING ERRCODE = 'restrict_violation',\n          HINT = 'Archived evidence is never edited, and is purged only after 400 days.';\nEND;\n$fn$ LANGUAGE plpgsql;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS evidence_artifact_archive_guard ON evidence_artifact_archive;",
      "global?": false,
      "name": "evidence_artifact_archive_guard_trigger",
      "up": "-- ash_enterprise_evidence_archive_guard: 6c7060e40f76c9e0\nCREATE OR REPLACE TRIGGER evidence_artifact_archive_guard\n  BEFORE UPDATE OR DELETE ON evidence_artifact_archive\n  FOR EACH ROW EXECUTE FUNCTION ash_enterprise_evidence_archive_guard();\n"
    }
  ],

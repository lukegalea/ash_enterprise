<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_credentialing_case"
                   targetNamespace="https://ash-enterprise.example/bpmn">
  <bpmn2:error id="Error_NoDocument" name="No licence document" errorCode="licence_document_missing"/>

  <bpmn2:process id="Process_credentialing_case" name="Credentialing case" isExecutable="true">

    <!--
      One credential's case (showcase slice 3, ADR 0055). It is published into the demo tenant
      by `AshEnterprise.Credentialing.CaseProcess`, not into the platform baselines: it is a
      worked example, not something every tenant inherits.

      The two evidence checks run side by side as service tasks through their invocations,
      as the person who opened the case. A refused check is an answer, not a fault: the
      documents check's business refusal is caught by its error boundary, which asks for the
      missing document and waits for it, while the expiry check carries on. The wait is a
      receive task correlated on the credential, so a delivery of the "document received"
      webhook that is repeated, or arrives before the case waits for it, moves the case on
      once. The parallel join fires when both branches have arrived.

      The committee decides on a user task, not on a service task: the decision is a
      person's. An approved case waits for its re-credentialing date on a timer catch event,
      which is a durable row that survives a restart, and ends when it falls due.
    -->

    <bpmn2:startEvent id="Start">
      <bpmn2:outgoing>F_start</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:parallelGateway id="Fork" name="Check the evidence">
      <bpmn2:incoming>F_start</bpmn2:incoming>
      <bpmn2:outgoing>F_documents</bpmn2:outgoing>
      <bpmn2:outgoing>F_expiry</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:serviceTask id="CheckDocuments" name="Check the licence documents">
      <bpmn2:extensionElements><ash:taskConfig action="check_licence_documents"/></bpmn2:extensionElements>
      <bpmn2:incoming>F_documents</bpmn2:incoming>
      <bpmn2:outgoing>F_documented</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:boundaryEvent id="NoDocument" name="No licence document" attachedToRef="CheckDocuments">
      <bpmn2:outgoing>F_missing</bpmn2:outgoing>
      <bpmn2:errorEventDefinition id="ErrDef_NoDocument" errorRef="Error_NoDocument"/>
    </bpmn2:boundaryEvent>

    <bpmn2:serviceTask id="RequestDocument" name="Ask for the document">
      <bpmn2:extensionElements><ash:taskConfig action="request_licence_document"/></bpmn2:extensionElements>
      <bpmn2:incoming>F_missing</bpmn2:incoming>
      <bpmn2:outgoing>F_requested</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:receiveTask id="AwaitDocument" name="Wait for the document">
      <bpmn2:extensionElements>
        <!-- The match names the action as well as the subject: the case's own request for the
             document is an envelope for the same credential, and the lookback scan offers the
             wait every event it finds, whatever its action. -->
        <ash:subscribe resource="AshEnterprise.Credentialing.DocumentEvent" action="receive"
                       correlate="subject.id" lookback="1440"
                       match="if event.action = &quot;receive&quot; then data.subject else null"/>
      </bpmn2:extensionElements>
      <bpmn2:incoming>F_requested</bpmn2:incoming>
      <bpmn2:outgoing>F_received</bpmn2:outgoing>
    </bpmn2:receiveTask>

    <bpmn2:serviceTask id="CheckExpiry" name="Check the expiry date">
      <bpmn2:extensionElements><ash:taskConfig action="check_licence_expiry"/></bpmn2:extensionElements>
      <bpmn2:incoming>F_expiry</bpmn2:incoming>
      <bpmn2:outgoing>F_in_date</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:parallelGateway id="Join" name="Evidence in">
      <bpmn2:incoming>F_documented</bpmn2:incoming>
      <bpmn2:incoming>F_received</bpmn2:incoming>
      <bpmn2:incoming>F_in_date</bpmn2:incoming>
      <bpmn2:outgoing>F_joined</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:userTask id="CommitteeReview" name="Committee review">
      <bpmn2:extensionElements>
        <ash:taskConfig>
          <ash:candidates>
            <ash:candidate kind="role" of="Credentialing committee"/>
          </ash:candidates>
          <ash:exclusions>
            <ash:exclusion who="subject.owner_id"/>
          </ash:exclusions>
          <ash:outcomes>
            <ash:outcome name="approved"/>
            <ash:outcome name="rejected"/>
          </ash:outcomes>
        </ash:taskConfig>
      </bpmn2:extensionElements>
      <bpmn2:incoming>F_joined</bpmn2:incoming>
      <bpmn2:outgoing>F_reviewed</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:exclusiveGateway id="Route" name="What did the committee decide?" default="F_rejected">
      <bpmn2:incoming>F_reviewed</bpmn2:incoming>
      <bpmn2:outgoing>F_approved</bpmn2:outgoing>
      <bpmn2:outgoing>F_rejected</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:intermediateCatchEvent id="Recredential" name="Re-credentialing due">
      <bpmn2:incoming>F_approved</bpmn2:incoming>
      <bpmn2:outgoing>F_due</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="Timer_recredential">
        <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">P365D</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:endEvent id="EndDue">
      <bpmn2:extensionElements><ash:taskConfig outcome="recredentialing_due"/></bpmn2:extensionElements>
      <bpmn2:incoming>F_due</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:endEvent id="EndRejected">
      <bpmn2:extensionElements><ash:taskConfig outcome="rejected"/></bpmn2:extensionElements>
      <bpmn2:incoming>F_rejected</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="F_start" sourceRef="Start" targetRef="Fork"/>
    <bpmn2:sequenceFlow id="F_documents" sourceRef="Fork" targetRef="CheckDocuments"/>
    <bpmn2:sequenceFlow id="F_expiry" sourceRef="Fork" targetRef="CheckExpiry"/>
    <bpmn2:sequenceFlow id="F_documented" sourceRef="CheckDocuments" targetRef="Join"/>
    <bpmn2:sequenceFlow id="F_missing" sourceRef="NoDocument" targetRef="RequestDocument"/>
    <bpmn2:sequenceFlow id="F_requested" sourceRef="RequestDocument" targetRef="AwaitDocument"/>
    <bpmn2:sequenceFlow id="F_received" sourceRef="AwaitDocument" targetRef="Join"/>
    <bpmn2:sequenceFlow id="F_in_date" sourceRef="CheckExpiry" targetRef="Join"/>
    <bpmn2:sequenceFlow id="F_joined" sourceRef="Join" targetRef="CommitteeReview"/>
    <bpmn2:sequenceFlow id="F_reviewed" sourceRef="CommitteeReview" targetRef="Route"/>
    <bpmn2:sequenceFlow id="F_approved" sourceRef="Route" targetRef="Recredential">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"
        language="feel">task.outcome = "approved"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="F_rejected" sourceRef="Route" targetRef="EndRejected"/>
    <bpmn2:sequenceFlow id="F_due" sourceRef="Recredential" targetRef="EndDue"/>
  </bpmn2:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_credentialing_case">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="100" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fork" bpmnElement="Fork">
        <dc:Bounds x="180" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CheckDocuments" bpmnElement="CheckDocuments">
        <dc:Bounds x="280" y="60" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_NoDocument" bpmnElement="NoDocument">
        <dc:Bounds x="322" y="122" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RequestDocument" bpmnElement="RequestDocument">
        <dc:Bounds x="440" y="150" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AwaitDocument" bpmnElement="AwaitDocument">
        <dc:Bounds x="600" y="150" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CheckExpiry" bpmnElement="CheckExpiry">
        <dc:Bounds x="280" y="300" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Join" bpmnElement="Join">
        <dc:Bounds x="780" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CommitteeReview" bpmnElement="CommitteeReview">
        <dc:Bounds x="880" y="180" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Route" bpmnElement="Route">
        <dc:Bounds x="1050" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Recredential" bpmnElement="Recredential">
        <dc:Bounds x="1150" y="122" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndDue" bpmnElement="EndDue">
        <dc:Bounds x="1230" y="122" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndRejected" bpmnElement="EndRejected">
        <dc:Bounds x="1150" y="262" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_F_start" bpmnElement="F_start">
        <di:waypoint x="136" y="220"/>
        <di:waypoint x="180" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_documents" bpmnElement="F_documents">
        <di:waypoint x="205" y="195"/>
        <di:waypoint x="205" y="100"/>
        <di:waypoint x="280" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_expiry" bpmnElement="F_expiry">
        <di:waypoint x="205" y="245"/>
        <di:waypoint x="205" y="340"/>
        <di:waypoint x="280" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_documented" bpmnElement="F_documented">
        <di:waypoint x="400" y="100"/>
        <di:waypoint x="805" y="100"/>
        <di:waypoint x="805" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_missing" bpmnElement="F_missing">
        <di:waypoint x="340" y="158"/>
        <di:waypoint x="340" y="190"/>
        <di:waypoint x="440" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_requested" bpmnElement="F_requested">
        <di:waypoint x="560" y="190"/>
        <di:waypoint x="600" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_received" bpmnElement="F_received">
        <di:waypoint x="720" y="190"/>
        <di:waypoint x="805" y="190"/>
        <di:waypoint x="805" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_in_date" bpmnElement="F_in_date">
        <di:waypoint x="400" y="340"/>
        <di:waypoint x="805" y="340"/>
        <di:waypoint x="805" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_joined" bpmnElement="F_joined">
        <di:waypoint x="830" y="220"/>
        <di:waypoint x="880" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_reviewed" bpmnElement="F_reviewed">
        <di:waypoint x="1000" y="220"/>
        <di:waypoint x="1050" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_approved" bpmnElement="F_approved">
        <di:waypoint x="1075" y="195"/>
        <di:waypoint x="1075" y="140"/>
        <di:waypoint x="1150" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_rejected" bpmnElement="F_rejected">
        <di:waypoint x="1075" y="245"/>
        <di:waypoint x="1075" y="280"/>
        <di:waypoint x="1150" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_due" bpmnElement="F_due">
        <di:waypoint x="1186" y="140"/>
        <di:waypoint x="1230" y="140"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>

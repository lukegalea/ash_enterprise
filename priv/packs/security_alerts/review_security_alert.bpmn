<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_review_security_alert"
                   targetNamespace="https://ash-enterprise.example/bpmn">
  <!--
    Review a security alert (SOC 2 CC7.2 and CC7.3: anomalies are detected and evaluated).
    Started by one of the security_alerts pack's recipes: an Administrator or Platform
    Operator role assigned, a break-glass session approved, an API key issued, a third
    refused sign-in in a row, or an inbound alert labelled security.

    One review by an administrator who is none of the people involved. The exclusions are
    subtracted from the candidates before the task is written:
      instance.started_by_id  the person whose write caused the event (who assigned the role)
      subject.created_by_id   the subject row's creator
      subject.user_id         the person a role was assigned to
      subject.subject         the person an occurrence is about (the break-glass operator,
                              the API key's owner, the person whose sign-in was refused)

    Human tasks only: nothing here acts on its own. An alert judged unexpected is recorded,
    not acted on; revoking, ending or locking stays a person's act.
  -->
  <bpmn2:process id="Process_review_security_alert" name="Review a security alert" isExecutable="true">

    <bpmn2:startEvent id="Start" name="Security event">
      <bpmn2:outgoing>Flow_to_review</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:userTask id="Review" name="Was this expected?">
      <bpmn2:extensionElements>
        <ash:taskConfig>
          <ash:candidates>
            <ash:candidate kind="role" of="Administrator"/>
          </ash:candidates>
          <ash:exclusions>
            <ash:exclusion who="instance.started_by_id"/>
            <ash:exclusion who="subject.created_by_id"/>
            <ash:exclusion who="subject.user_id"/>
            <ash:exclusion who="subject.subject"/>
          </ash:exclusions>
          <ash:outcomes>
            <ash:outcome name="approved"/>
            <ash:outcome name="rejected"/>
          </ash:outcomes>
        </ash:taskConfig>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_to_review</bpmn2:incoming>
      <bpmn2:outgoing>Flow_to_route</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:exclusiveGateway id="Route" name="Expected?" default="Flow_unexpected">
      <bpmn2:incoming>Flow_to_route</bpmn2:incoming>
      <bpmn2:outgoing>Flow_expected</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_unexpected</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:endEvent id="EndExpected" name="Expected">
      <bpmn2:extensionElements><ash:taskConfig outcome="expected"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_expected</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:endEvent id="EndUnexpected" name="Unexpected">
      <bpmn2:extensionElements><ash:taskConfig outcome="unexpected"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_unexpected</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="Flow_to_review" sourceRef="Start" targetRef="Review"/>
    <bpmn2:sequenceFlow id="Flow_to_route" sourceRef="Review" targetRef="Route"/>
    <bpmn2:sequenceFlow id="Flow_expected" sourceRef="Route" targetRef="EndExpected">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"
        language="feel">task.outcome = "approved"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_unexpected" sourceRef="Route" targetRef="EndUnexpected"/>
  </bpmn2:process>

  <bpmndi:BPMNDiagram id="Diagram_review_security_alert">
    <bpmndi:BPMNPlane id="Plane_review_security_alert" bpmnElement="Process_review_security_alert">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="150" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Review" bpmnElement="Review">
        <dc:Bounds x="240" y="180" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Route" bpmnElement="Route" isMarkerVisible="true">
        <dc:Bounds x="440" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndExpected" bpmnElement="EndExpected">
        <dc:Bounds x="560" y="132" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndUnexpected" bpmnElement="EndUnexpected">
        <dc:Bounds x="560" y="272" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_to_review" bpmnElement="Flow_to_review">
        <di:waypoint x="186" y="220"/>
        <di:waypoint x="240" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_to_route" bpmnElement="Flow_to_route">
        <di:waypoint x="380" y="220"/>
        <di:waypoint x="440" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_expected" bpmnElement="Flow_expected">
        <di:waypoint x="465" y="195"/>
        <di:waypoint x="465" y="150"/>
        <di:waypoint x="560" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_unexpected" bpmnElement="Flow_unexpected">
        <di:waypoint x="465" y="245"/>
        <di:waypoint x="465" y="290"/>
        <di:waypoint x="560" y="290"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>

msgstr "Le résultat est incertain"

#: lib/ash_enterprise_web/live/recovery_live.ex:494
#, elixir-autogen, elixir-format
msgid "The outside system is being asked what happened. If it cannot say, a person is asked here."
msgstr "Le système externe est interrogé sur ce qui s'est produit. S'il ne peut répondre, une personne est sollicitée ici."

#: lib/ash_enterprise_web/live/recovery_live.ex:557
#, elixir-autogen, elixir-format
msgid "The recorded arguments are still valid."
msgstr "Les arguments enregistrés sont toujours valides."

#: lib/ash_enterprise_web/live/recovery_live.ex:560
#, elixir-autogen, elixir-format
msgid "The recorded arguments would be refused: %{why}"
msgstr "Les arguments enregistrés seraient refusés : %{why}"

#: lib/ash_enterprise_web/live/recovery_live.ex:551
#, elixir-autogen, elixir-format
msgid "The target changed since this request: a rerun runs it as it is now."
msgstr "La cible a changé depuis cette demande : une relance l'exécute dans son état actuel."

#: lib/ash_enterprise_web/live/recovery_live.ex:548
#, elixir-autogen, elixir-format
msgid "The target no longer resolves."
msgstr "La cible ne se résout plus."

#: lib/ash_enterprise_web/live/recovery_live.ex:520
#, elixir-autogen, elixir-format
msgid "This request stays as it is."
msgstr "Cette demande reste telle quelle."

#: lib/ash_enterprise_web/live/recovery_live.ex:303
#, elixir-autogen, elixir-format
msgid "Uncertain outcomes"
msgstr "Résultats incertains"

#: lib/ash_enterprise_web/live/recovery_live.ex:470

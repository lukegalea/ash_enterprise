{
  "name": "ash-enterprise-slo",
  "schemaVersion": "v6",
  "tags": [
    {
      "key": "stack",
      "value": "slo"
    }
  ],
  "spec": {
    "display": {
      "name": "SLO",
      "description": "The default objectives: 99.5% of /health probes answered over 30 days, and p95 Ash action latency under 500 ms. Both are unmeasured defaults until a deployment runs against them."
    },
    "duration": "7d",
    "links": [],
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "service",
          "display": {
            "name": "Service"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "traces"
            }
          }
        }
      }
    ],
    "panels": {
      "health-probes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "/health probes by status",
            "description": "Server spans for /health, by response status: the availability SLI's numerator (2xx) and denominator (all)."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name IN $service AND kind_string = 'Server' AND url.path = '/health'"
                    },
                    "groupBy": [
                      {
                        "name": "http.response.status_code",
                        "fieldContext": "attribute",
                        "fieldDataType": "int64"
                      }
                    ],
                    "legend": "{{http.response.status_code}}"
                  }
                }
              }
            }
          ]
        }
      },
      "health-failures": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "/health probes failed",
            "description": "Server spans for /health that answered 5xx: what spends the error budget."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name IN $service AND kind_string = 'Server' AND url.path = '/health' AND http.response.status_code >= 500"
                    },
                    "groupBy": [
                      {
                        "name": "service.name",
                        "fieldContext": "resource",
                        "fieldDataType": "string"
                      }
                    ],
                    "legend": "{{service.name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "ash-p95": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Ash action p95",
            "description": "ash.action.duration (metric), against the 500 ms objective."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "formatting": {
                "unit": "ms",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "ash.action.duration.bucket",
                        "spaceAggregation": "p95",
                        "timeAggregation": ""
                      }
                    ],
                    "filter": {
                      "expression": "service.name IN $service"
                    },
                    "groupBy": [
                      {
                        "name": "service.name",
                        "fieldContext": "resource",
                        "fieldDataType": "string"
                      }
                    ],
                    "legend": "{{service.name}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/health-probes"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/health-failures"
              }
            },
            {
              "x": 0,
              "y": 6,
              "width": 12,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/ash-p95"
              }
            }
          ]
        }
      }
    ]
  }
}

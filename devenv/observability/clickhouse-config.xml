<clickhouse>
  <logger><level>warning</level><console>1</console></logger>
  <listen_host>127.0.0.1</listen_host>
  <listen_try>0</listen_try>
  <!-- Moves the Keeper Raft listener off the wildcard address. -->
  <interserver_listen_host>127.0.0.1</interserver_listen_host>
  <http_port>@CLICKHOUSE_HTTP@</http_port>
  <tcp_port>@CLICKHOUSE_TCP@</tcp_port>
  <interserver_http_port>@CLICKHOUSE_INTERSERVER@</interserver_http_port>
  <path>@DATA@/</path>
  <tmp_path>@DATA@/tmp/</tmp_path>
  <user_files_path>@DATA@/user_files/</user_files_path>
  <user_scripts_path>@DATA@/user_scripts/</user_scripts_path>
  <format_schema_path>@DATA@/format_schemas/</format_schema_path>
  <user_defined_executable_functions_config>@CONF@/histogram-quantile-function.xml</user_defined_executable_functions_config>
  <users_config>@CONF@/clickhouse-users.xml</users_config>
  <default_profile>default</default_profile>
  <default_database>default</default_database>
  <mlock_executable>false</mlock_executable>
  <!--
    Off, so the 1 GiB cap below is measured against this server alone. On, the
    memory worker reads the cgroup's usage as the server's own RSS, and inside a
    cgroup shared with other processes (a dev container, a terminal multiplexer's
    service) every query fails with MEMORY_LIMIT_EXCEEDED.
  -->
  <memory_worker_use_cgroup>false</memory_worker_use_cgroup>
  <!--
    1 GiB. The cap counts RSS, about 200 MB of which is the server's own code. At
    640 MiB, a burst of about 13,000 spans (one Keystone browser-test run) pushed
    RSS to 660-690 MiB, and the server rejected inserts and queries with
    MEMORY_LIMIT_EXCEEDED, so spans were lost. Steady RSS stays near 330 MB.
  -->
  <max_server_memory_usage>1073741824</max_server_memory_usage>
  <!-- 48, not lower: the traces exporter writes many tables in parallel, and code 202
       makes it retry, which duplicates span rows. -->
  <max_concurrent_queries>48</max_concurrent_queries>
  <max_connections>64</max_connections>
  <mark_cache_size>67108864</mark_cache_size>
  <index_mark_cache_size>16777216</index_mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>
  <primary_index_cache_size>33554432</primary_index_cache_size>
  <query_condition_cache_size>16777216</query_condition_cache_size>
  <compiled_expression_cache_size>8388608</compiled_expression_cache_size>
  <page_cache_max_size>0</page_cache_max_size>
  <query_cache><max_size_in_bytes>0</max_size_in_bytes></query_cache>
  <background_pool_size>2</background_pool_size>
  <background_schedule_pool_size>8</background_schedule_pool_size>
  <background_common_pool_size>2</background_common_pool_size>
  <background_move_pool_size>1</background_move_pool_size>
  <background_fetches_pool_size>1</background_fetches_pool_size>
  <max_thread_pool_size>500</max_thread_pool_size>
  <merge_tree>
    <!-- A background_pool_size of 2 aborts startup unless these drop with it. -->
    <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
    <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
    <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    <!--
      Vertical merges for every part, not only parts over 131,072 rows. A
      horizontal merge reads every column of every source part at once; for
      signoz_index_v3 (81 columns, JSON among them) over the 100 small parts a
      stack accumulates in a day, that is more than the cap allows, the merge
      fails, retries, and starves inserts, so the collector's writes fail too. A
      vertical merge reads one column at a time. Measured on such a data set: the
      backlog cleared in 15s at a peak RSS of 487 MB, where the horizontal merge
      never finished. The cap counts RSS, including about 200 MB of the server's
      own code, so fewer parts per merge (max_parts_to_merge_at_once 10) and
      smaller blocks (merge_max_block_size 1024) were not enough on their own.
    -->
    <vertical_merge_algorithm_min_rows_to_activate>1</vertical_merge_algorithm_min_rows_to_activate>
    <vertical_merge_algorithm_min_columns_to_activate>1</vertical_merge_algorithm_min_columns_to_activate>
  </merge_tree>
  <macros><shard>00</shard><replica>00</replica></macros>
  <remote_servers>
    <cluster>
      <shard><internal_replication>true</internal_replication>
        <replica><host>127.0.0.1</host><port>@CLICKHOUSE_TCP@</port></replica>
      </shard>
    </cluster>
  </remote_servers>
  <zookeeper><node><host>127.0.0.1</host><port>@KEEPER@</port></node></zookeeper>
  <distributed_ddl><path>/clickhouse/task_queue/ddl</path></distributed_ddl>
  <keeper_server>
    <tcp_port>@KEEPER@</tcp_port>
    <server_id>1</server_id>
    <log_storage_path>@DATA@/keeper_log</log_storage_path>
    <snapshot_storage_path>@DATA@/keeper_snap</snapshot_storage_path>
    <coordination_settings>
      <operation_timeout_ms>10000</operation_timeout_ms>
      <session_timeout_ms>30000</session_timeout_ms>
      <force_sync>false</force_sync>
      <max_requests_batch_size>100</max_requests_batch_size>
      <latest_logs_cache_size_threshold>8388608</latest_logs_cache_size_threshold>
      <commit_logs_cache_size_threshold>8388608</commit_logs_cache_size_threshold>
      <snapshot_distance>10000</snapshot_distance>
    </coordination_settings>
    <raft_configuration>
      <server><id>1</id><hostname>127.0.0.1</hostname><port>@RAFT@</port></server>
    </raft_configuration>
  </keeper_server>
  <!--
    System log sections are absent on purpose. A standalone file is not a merge, so
    remove="1" leaves the element in place and creates the log with default settings.
  -->
  <asynchronous_metrics_update_period_s>60</asynchronous_metrics_update_period_s>
  <send_crash_reports><enabled>false</enabled></send_crash_reports>
</clickhouse>

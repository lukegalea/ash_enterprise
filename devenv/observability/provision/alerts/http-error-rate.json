{
  "alert": "HTTP server error rate above 5%",
  "alertType": "TRACES_BASED_ALERT",
  "description": "More than 5% of server requests answered 5xx over five minutes.",
  "annotations": {
    "summary": "{{$service.name}}: {{$value}}% of requests failed",
    "description": "More than 5% of server requests answered 5xx over five minutes."
  },
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "traces",
            "aggregations": [
              {
                "expression": "count()"
              }
            ],
            "filter": {
              "expression": "kind_string = 'Server' AND http.response.status_code >= 500"
            },
            "groupBy": [
              {
                "name": "service.name",
                "fieldContext": "resource",
                "fieldDataType": "string"
              }
            ],
            "legend": "",
            "disabled": true,
            "stepInterval": 60
          }
        },
        {
          "type": "builder_query",
          "spec": {
            "name": "B",
            "signal": "traces",
            "aggregations": [
              {
                "expression": "count()"
              }
            ],
            "filter": {
              "expression": "kind_string = 'Server'"
            },
            "groupBy": [
              {
                "name": "service.name",
                "fieldContext": "resource",
                "fieldDataType": "string"
              }
            ],
            "legend": "",
            "disabled": true,
            "stepInterval": 60
          }
        },
        {
          "type": "builder_formula",
          "spec": {
            "name": "F1",
            "expression": "(A / B) * 100",
            "legend": "{{service.name}}"
          }
        }
      ],
      "unit": "percent"
    },
    "selectedQueryName": "F1",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "op": "above",
          "target": 5,
          "matchType": "at_least_once",
          "channels": []
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m",
      "frequency": "1m"
    }
  },
  "labels": {
    "severity": "warning",
    "provisioned": "observability"
  },
  "notificationSettings": {
    "usePolicy": true,
    "renotify": {
      "enabled": false,
      "interval": "30m",
      "alertStates": [
        "firing"
      ]
    }
  },
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "version": "v5"
}

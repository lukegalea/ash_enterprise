{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-ash-codegen.sh\"",
            "async": true,
            "asyncRewake": true,
            "timeout": 300,
            "statusMessage": "Checking Ash codegen drift",
            "rewakeSummary": "Ash codegen check",
            "rewakeMessage": "A background Ash codegen check has something to report. Read it carefully — it distinguishes real drift from the check being unable to run, and only the former calls for generating a migration:"
          }
        ]
      }
    ]
  }
}

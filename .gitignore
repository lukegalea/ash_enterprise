# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
ash_enterprise-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# devenv: the nix-managed dev environment. .devenv/state holds the Postgres
# data directory, MIX_HOME and HEX_HOME, so it is large and entirely local.
.devenv*
devenv.local.nix
devenv.local.yaml
.direnv

# pre-commit / git-hooks are generated by devenv from devenv.nix
.pre-commit-config.yaml

# Local secrets. .env.example is the committed template.
.env

# Dialyzer PLTs
/priv/plts/


# Cached upstream Dataverse table-reference markdown. The committed JSON in
# priv/cdm/resolved/ is the artifact; this is just a scraper cache.
/priv/cdm/.docs_cache/

# Release artifacts
/_build/prod/*.tar.gz

# Personal Claude Code overrides. .claude/settings.json is the shared one.
.claude/settings.local.json

# The marketing site (site/) is a separate Astro project. Its content collection
# is generated from docs/ by site/scripts/sync-docs.mjs, so it is never committed.
/site/node_modules/
/site/dist/
/site/.astro/
/site/src/content/docs/
# The share card is composed from docs/roadmap.json at build time, so committing
# it would mean a binary that goes stale every time a question changes status.
/site/public/og.png
